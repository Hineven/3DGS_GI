// Try to resolve trace results from either screen history or hash grid cache
[numthreads(WAVE_SIZE, 1, 1)]
void ResolveReflectionTraceResults (uint DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(DispatchID >= g_RWRayToTraceCountBuffer[0]) return;
	int RayIndex = g_RWRayToTraceListBuffer[DispatchID];
	float2 FilmPosition = UnpackUnorm16x2(g_RWRayToTraceUVPositionBuffer[RayIndex]) * C.FilmDimensions;
	int2 PixelCoords = int2(FilmPosition);
	RayToTrace Ray = FetchRayToTrace(RayIndex, UB.RT_MaxTraceDistance, false);
	{
		float LinearDepth = GetFilteredDepthTexture(C).Load(int3(PixelCoords, 0)).x;
		Ray.Origin = RecoverWorldSpacePosition(C, PixelCoords + 0.5f, LinearDepth);
	}
	float4 ResolvedRadiance = 0;
	if(Ray.bHit) {
		bool bReprojected = false;
		// Try to resolve radiance from screen history
		float3 HitWorldPosition = Ray.Origin + Ray.Direction * Ray.RayTMin;
		float4 PreviousHomogeneousW = mul(GetCameraDescription(true).ProjectionView, float4(HitWorldPosition, 1));
		float3 PreviousHomogeneous = PreviousHomogeneousW.xyz / PreviousHomogeneousW.w;
		if(PreviousHomogeneousW.w > 0 && all(PreviousHomogeneous.xy >= -1) && all(PreviousHomogeneous.xy <= 1)
		&& PreviousHomogeneous.z >= 0 && PreviousHomogeneous.z <= 1) {
			float2 HistoryScreenPosition = UB.ScreenDimensions * NDC2ToUV(PreviousHomogeneous.xy);
			int2 HistoryScreenCoords = int2(HistoryScreenPosition + 0.5f);
			float3 HistoryNormal = normalize(GetHistoryNormalTexture(C).Load(int3(HistoryScreenCoords, 0)).xyz * 2.f - 1.f);
			uint2  PackedHitResult = g_RWRayToTraceResultBuffer[RayIndex];
			float3 HitNormal     = UnpackNormal(PackedHitResult.y);
			float  HistoryZDepth = GetHistoryZDepthTexture(C).Load(int3(HistoryScreenCoords, 0)).x;
			if(HistoryZDepth <= 1) {
				float  HistoryDepth  = ZDepthToLinear(C, HistoryZDepth);
				float  PreviousDepth = ZDepthToLinear(C, PreviousHomogeneous.z);
				bool   bNormalVisible = dot(HistoryNormal, HitNormal) > 0.5f;
				bool   bDepthVisible  =  abs(HistoryDepth - PreviousDepth)  / max(PreviousDepth, HistoryDepth) < 5e-2f;
				if(bNormalVisible && bDepthVisible) {
					float3 HistoryRadiance = g_HistoryRadiance.Load(int3(HistoryScreenCoords, 0)).xyz;
					ResolvedRadiance = float4(HistoryRadiance, 1.f);
					bReprojected = true;
				}
			}
		}
		if(!bReprojected) {
			// If an emissive object is hit, the emission will be stored in hit result buffer
			uint2  PackedHitResult = g_RWRayToTraceResultBuffer[RayIndex];
			float3 Emission = UnpackRadianceU32(PackedHitResult.x);
			ResolvedRadiance = float4(Emission, 1.f);

			// If reprojection failed, we have to query the hash grid radiance cache as last resort.
			HashGridsKey CacheKey = HashGrids_GetEntryKey(HitWorldPosition, -Ray.Direction, Ray.RayTMin);
			uint BucketSlotIndex = HashGrids_Find(CacheKey.BucketHash);
			if(!IsInvalid(BucketSlotIndex)) {
				uint TileIndex = g_HashGrids_BucketTileIndexBuffer[BucketSlotIndex];
				uint PrevTimestamp, Timestamp = UB.FrameIndex;
				// Touch the tile to prevent it from being recycled
				InterlockedExchange(g_HashGrids_TileTimestampBuffer[TileIndex], Timestamp, PrevTimestamp);
				uint CellIndex = HashGrids_GetCellIndex(TileIndex, CacheKey.CellOffset);
				float4 Radiance = HashGrids_GetFilteredRadiance(CellIndex);
				ResolvedRadiance.rgb += Radiance.rgb;
			}
		}
	} else {
		// Miss, sample radiance from sky
		float3 SkyRadiance = EvaluateSkyRadiance(-Ray.Direction, UB.LightingSkyRadianceLOD);
		ResolvedRadiance = float4(SkyRadiance, 1.f);
		Ray.RayTMin = UB.RT_MaxTraceDistance;
	}
	g_RWReflectionTexture[PixelCoords] = ResolvedRadiance;
	g_RWReflectionSTDRayDepthTexture[PixelCoords].w = Ray.RayTMin;
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void SpatialFilterReflection (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	int2 PixelCoords = int2(DispatchID);
	float3 Radiance = g_RWReflectionTexture[PixelCoords].xyz;
	float  LinearDepth = GetFilteredDepthTexture(C).Load(int3(PixelCoords, 0)).x;
	if(LinearDepth == 0) return; // Transparent
	float3 ViewDirection = -NDC2ToCameraDirection(C, ScreenToNDC2(PixelCoords));
	Material M = FetchMaterial(C, PixelCoords);
	float RoughnessAlpha = squared(M.Roughness);
	float3 Tangent, Bitangent;
	GetOrthoVectors(M.Normal, Tangent, Bitangent);
	float3 LocalViewDirection = float3(
		dot(Tangent,   ViewDirection),
		dot(Bitangent, ViewDirection),
		dot(M.Normal,  ViewDirection)
	);
	
	float3 SumReflection = 0;
	float4 SumSquaredReflectionRayDepth = 0;
	float  SumSampleCount = 0;
	int StepSize = (1 << FILTER_PASS);
	for(int i = -FILTER_RADIUS; i <= FILTER_RADIUS; i++) {
		for(int j = -FILTER_RADIUS; j <= FILTER_RADIUS; j++) {
			int2 Offset = int2(i, j) * StepSize;
			int2 NeighborCoords = PixelCoords + Offset;
			if(all(NeighborCoords >= 0) && all(NeighborCoords < C.FilmDimensions)) {
				float4 NeighborRadiance = g_RWReflectionTexture[NeighborCoords];
				float  NeighborLinearDepth = GetFilteredDepthTexture(C).Load(int3(NeighborCoords, 0)).x;
				if(NeighborLinearDepth == 0 || NeighborRadiance.w == 0) continue; // Transparent or no sample.
				float3 NeighborNormal   = normalize(2 * GetNormalTexture(C).Load(int3(NeighborCoords, 0)).xyz - 1);
				float  DepthWeight  = GetFilterPositionWeight(NeighborLinearDepth, LinearDepth);
				float3 NeighborReflectionRayDirection  = UnpackNormal(g_RWReflectionDirectionTexture[NeighborCoords].r);
				float  NeighborReflectionRayDepth      = g_RWReflectionSTDRayDepthTexture[NeighborCoords].w;
				// float3 NeighborWorldPosition           = RecoverWorldSpacePosition(C, NeighborCoords + 0.5f, NeighborLinearDepth);
				// float3 NeighborHitWorldPosition        = NeighborWorldPosition + NeighborReflectionRayDirection * NeighborReflectionRayDepth;
				float3 LightDirection                  = NeighborReflectionRayDirection;
				float3 HalfVector                      = normalize(ViewDirection + LightDirection);
				float  DotNH                           = saturate(dot(M.Normal, HalfVector));
				float  DotNV                           = saturate(dot(M.Normal, ViewDirection));
				// Damn this works not very well (and is time consuming)
				float  PdfWeight = dot(LightDirection, M.Normal) <= 0 ? 0 : sampleGGXPDF(RoughnessAlpha, DotNH, DotNV, LocalViewDirection);
				if(isnan(PdfWeight)) PdfWeight = 0;
				// Clamp to 1 (no more than 1 sample)
				PdfWeight = saturate(PdfWeight);
				// float PdfWeight = pow(saturate(dot(M.Normal, NeighborNormal)), AdaptiveNum);
				float  GaussianWeight = DilatedConvolutionKernelWeight(Offset, UB.Reflection_InvFilterRadius, UB.Reflection_InvFilterRadius2);
				float  Similarity = DepthWeight * PdfWeight * GaussianWeight;
				// If the pixel is current pixel, overwrite the similarity to 1
				Similarity = all(Offset == 0) ? 1 : Similarity;
				float  Weight = Similarity * NeighborRadiance.w;
				SumReflection += NeighborRadiance.rgb * Weight;
#if FILTER_PASS == 0
				float3 NeighborRadianceSquared = NeighborRadiance.rgb * NeighborRadiance.rgb;
#else
				float3 NeighborRadianceSquared = g_RWReflectionSTDRayDepthTexture[NeighborCoords].xyz;
#endif
				SumSquaredReflectionRayDepth += float4(NeighborRadianceSquared, NeighborReflectionRayDepth) * Weight;
				SumSampleCount += Weight;
			}
		}
	}
	float3 AvgReflection = SumReflection / max(SumSampleCount, 1e-3f);
	g_RWFilteredReflectionTexture[PixelCoords] = 
		float4(AvgReflection, SumSampleCount);
	float4 AvgSquaredRayDepth = SumSquaredReflectionRayDepth / max(SumSampleCount, 1e-3f);

#if FILTER_PASS == 2 // last pass
	float3 STD = sqrt(max(AvgSquaredRayDepth.xyz - AvgReflection * AvgReflection, 0));
	g_RWFilteredReflectionSTDRayDepthTexture[PixelCoords] = float4(STD, AvgSquaredRayDepth.w);
#else
	g_RWFilteredReflectionSTDRayDepthTexture[PixelCoords] = AvgSquaredRayDepth;
#endif
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void TemporalDenoiseReflection (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	int2 PixelCoords = int2(DispatchID);
	Material M = FetchMaterial(C, PixelCoords);
	if(M.Alpha < UB.OpaqueThreshold) {
		return;
	}
	float PixelZDepth = GetZDepthTexture(C).Load(int3(PixelCoords, 0)).x;
	float2 ScreenPosition = PixelCoords + 0.5f.xx;
	float3 WorldNDC = float3(ScreenToNDC2(ScreenPosition), PixelZDepth);
	float  WorldLinearDepth = ZDepthToLinear(C, WorldNDC.z);
	float4 STDRayDepth = g_RWReflectionSTDRayDepthTexture[PixelCoords];
	// By assuming the screen pixel lies on a local planar, we can do 2-nd source reprojection by mirroring the hit.
	float  HitLinearDepth   = WorldLinearDepth + STDRayDepth.w;
	float3 HitNDC   = float3(ScreenToNDC2(ScreenPosition), LinearToZDepth(C, HitLinearDepth));
	float3 PreviousWorldNDC = ReprojectToPreviousNDCFromNDC(C, WorldNDC);
	float3 PreviousHitNDC   = ReprojectToPreviousNDCFromNDC(C, HitNDC);
	float3 ViewDirection = -NDC2ToCameraDirection(C, WorldNDC.xy);
	float3 Normal = normalize(GetNormalTexture(C).Load(int3(PixelCoords, 0)).xyz - 0.5);
	float4 OldWorldReflection = 0;
	float4 OldHitReflection   = 0;
	// Reproject from previous pixel
	if(all(PreviousWorldNDC.xy >= -1) && all(PreviousWorldNDC.xy <= 1)) {
		float2 PreviousScreenPosition = NDC2ToScreen(PreviousWorldNDC.xy);
		// Make sure the billinear weights are consistent with gathered texels
		float2 HistoryBillinearPos = PreviousScreenPosition - 0.5f;
		float2 HistoryBillinearSubPixel = frac(HistoryBillinearPos);
		float2 HistoryBillinearPixel = floor(HistoryBillinearPos);
		float2 HistoryGatherUV = (HistoryBillinearPixel + 1.f) * C.InvFilmDimensions;
		float4 HistoryZDepths = GetHistoryZDepthTexture(C).GatherRed(g_PointClampSampler, HistoryGatherUV).wzxy;
		float  PrevLinearDepth = ZDepthToLinear(C, PreviousWorldNDC.z);
		float4 HistoryLinearDepths = float4(
			ZDepthToLinear(C, HistoryZDepths.x),
			ZDepthToLinear(C, HistoryZDepths.y),
			ZDepthToLinear(C, HistoryZDepths.z),
			ZDepthToLinear(C, HistoryZDepths.w)
		);
		float4 DepthDistances = abs(HistoryLinearDepths - PrevLinearDepth);
		float  Noise = InterleavedGradientNoise(NDC2ToUV(WorldNDC.xy), UB.FrameIndex);
		float4 DepthThresholds = UB.DI_Denoiser_DepthThreshold * lerp(0.5, 1.5, Noise);
		// UE's resolution for disocclusion misses on geometry edges
		DepthThresholds /= clamp(saturate(dot(ViewDirection, Normal)), .1f, 1.0f); 
		float4 OcclusionWeights   = select(DepthDistances < PrevLinearDepth * DepthThresholds, 1, 0);
		float4 NormalWeights = 0;
		{
			float2 BaseUV = ScreenToUV(HistoryBillinearPixel + 0.5f);
			float3 N00 = normalize(2.f * g_HistoryNormalTexture.SampleLevel(g_PointClampSampler, BaseUV, 0).xyz - 1.f);
			float3 N10 = normalize(2.f * g_HistoryNormalTexture.SampleLevel(g_PointClampSampler, BaseUV + float2(C.FilmTexelSize.x, 0), 0).xyz - 1.f);
			float3 N01 = normalize(2.f * g_HistoryNormalTexture.SampleLevel(g_PointClampSampler, BaseUV + float2(0, C.FilmTexelSize.y), 0).xyz - 1.f);
			float3 N11 = normalize(2.f * g_HistoryNormalTexture.SampleLevel(g_PointClampSampler, BaseUV + C.FilmTexelSize, 0).xyz - 1.f);
			NormalWeights = float4(
				dot(N00, Normal),
				dot(N10, Normal),
				dot(N01, Normal),
				dot(N11, Normal)
			);
			NormalWeights = exp((saturate(NormalWeights) - 1) * 1.5f);
		}
		float4 BillinearWeights = float4(
			(1.f - HistoryBillinearSubPixel.x) * (1.f - HistoryBillinearSubPixel.y),
			HistoryBillinearSubPixel.x * (1.f - HistoryBillinearSubPixel.y),
			(1.f - HistoryBillinearSubPixel.x) * HistoryBillinearSubPixel.y,
			HistoryBillinearSubPixel.x * HistoryBillinearSubPixel.y
		);
		float4 Weights = OcclusionWeights * BillinearWeights * NormalWeights;
		Weights = Weights / max(dot(Weights, 1), 1e-3f);

		{
			float2 BaseUV = ScreenToUV(HistoryBillinearPixel + 0.5f);
			float3 R00 = g_HistoryReflectionTexture.SampleLevel(g_PointClampSampler, BaseUV, 0).rgb;
			float3 R10 = g_HistoryReflectionTexture.SampleLevel(g_PointClampSampler, BaseUV + float2(C.FilmTexelSize.x, 0), 0).rgb;
			float3 R01 = g_HistoryReflectionTexture.SampleLevel(g_PointClampSampler, BaseUV + float2(0, C.FilmTexelSize.y), 0).rgb;
			float3 R11 = g_HistoryReflectionTexture.SampleLevel(g_PointClampSampler, BaseUV + C.FilmTexelSize, 0).rgb;
			OldWorldReflection.rgb = R00 * Weights.x + R10 * Weights.y + R01 * Weights.z + R11 * Weights.w;
		}

		float4 HistorySampleCounts = g_HistoryReflectionTexture.GatherAlpha(g_PointClampSampler, HistoryGatherUV).wzxy;
		float OldSampleCount = dot(HistorySampleCounts * Weights, 1.f.xxxx);
		OldWorldReflection.a = OldSampleCount;
	}
	// Reproject from previous hit
	if(all(PreviousHitNDC.xy >= -1) && all(PreviousHitNDC.xy <= 1)) {
		float2 PreviousScreenPosition = NDC2ToScreen(PreviousHitNDC.xy);
		// Make sure the billinear weights are consistent with gathered texels
		float2 HistoryBillinearPos = PreviousScreenPosition - 0.5f;
		float2 HistoryBillinearSubPixel = frac(HistoryBillinearPos);
		float2 HistoryBillinearPixel = floor(HistoryBillinearPos);
		float2 HistoryGatherUV = (HistoryBillinearPixel + 1.f) * C.InvFilmDimensions;
		float4 HistoryZDepths = GetHistoryZDepthTexture(C).GatherRed(g_PointClampSampler, HistoryGatherUV).wzxy;
		float  PrevLinearDepth = WorldLinearDepth; // Just reuse current frame's depth
		float4 HistoryLinearDepths = float4(
			ZDepthToLinear(C, HistoryZDepths.x),
			ZDepthToLinear(C, HistoryZDepths.y),
			ZDepthToLinear(C, HistoryZDepths.z),
			ZDepthToLinear(C, HistoryZDepths.w)
		);
		float4 DepthDistances = abs(HistoryLinearDepths - PrevLinearDepth);
		float  Noise = InterleavedGradientNoise(NDC2ToUV(WorldNDC.xy), UB.FrameIndex);
		float4 DepthThresholds = UB.DI_Denoiser_DepthThreshold * lerp(0.5, 1.5, Noise);
		// UE's resolution for disocclusion misses on geometry edges
		DepthThresholds /= clamp(saturate(dot(ViewDirection, Normal)), .1f, 1.0f); 
		float4 OcclusionWeights   = select(DepthDistances < PrevLinearDepth * DepthThresholds, 1, 0);
		float4 BillinearWeights = float4(
			(1.f - HistoryBillinearSubPixel.x) * (1.f - HistoryBillinearSubPixel.y),
			HistoryBillinearSubPixel.x * (1.f - HistoryBillinearSubPixel.y),
			(1.f - HistoryBillinearSubPixel.x) * HistoryBillinearSubPixel.y,
			HistoryBillinearSubPixel.x * HistoryBillinearSubPixel.y
		);
		float4 NormalWeights = 0;
		{
			float2 BaseUV = ScreenToUV(HistoryBillinearPixel + 0.5f);
			float3 N00 = normalize(2.f * g_HistoryNormalTexture.SampleLevel(g_PointClampSampler, BaseUV, 0).xyz - 1.f);
			float3 N10 = normalize(2.f * g_HistoryNormalTexture.SampleLevel(g_PointClampSampler, BaseUV + float2(C.FilmTexelSize.x, 0), 0).xyz - 1.f);
			float3 N01 = normalize(2.f * g_HistoryNormalTexture.SampleLevel(g_PointClampSampler, BaseUV + float2(0, C.FilmTexelSize.y), 0).xyz - 1.f);
			float3 N11 = normalize(2.f * g_HistoryNormalTexture.SampleLevel(g_PointClampSampler, BaseUV + C.FilmTexelSize, 0).xyz - 1.f);
			NormalWeights = float4(
				dot(N00, Normal),
				dot(N10, Normal),
				dot(N01, Normal),
				dot(N11, Normal)
			);
			NormalWeights = exp((saturate(NormalWeights) - 1) * 1.5f);
		}
		float4 Weights = OcclusionWeights * BillinearWeights;
		Weights = Weights / max(dot(Weights, 1), 1e-3f);

		{
			float2 BaseUV = ScreenToUV(HistoryBillinearPixel + 0.5f);
			float3 R00 = g_HistoryReflectionTexture.SampleLevel(g_PointClampSampler, BaseUV, 0).rgb;
			float3 R10 = g_HistoryReflectionTexture.SampleLevel(g_PointClampSampler, BaseUV + float2(C.FilmTexelSize.x, 0), 0).rgb;
			float3 R01 = g_HistoryReflectionTexture.SampleLevel(g_PointClampSampler, BaseUV + float2(0, C.FilmTexelSize.y), 0).rgb;
			float3 R11 = g_HistoryReflectionTexture.SampleLevel(g_PointClampSampler, BaseUV + C.FilmTexelSize, 0).rgb;
			OldHitReflection.rgb = R00 * Weights.x + R10 * Weights.y + R01 * Weights.z + R11 * Weights.w;
		}
		float4 HistorySampleCounts = g_HistoryReflectionTexture.GatherAlpha(g_PointClampSampler, HistoryGatherUV).wzxy;
		float OldSampleCount = dot(HistorySampleCounts * Weights, 1.f.xxxx);
		OldHitReflection.a = OldSampleCount;
	}
	// Clamping and blending
	float4 NewReflection        = g_RWReflectionTexture[PixelCoords];
	NewReflection.a = min(NewReflection.a, 1.f); // Clamp to 1
	float4 DenoisedReflection   = 0;
	{
        float  luminance_diff_scale = 1e-2f * exp2(UB.TonemapExposure);
	    float  HistoryHitW   = OldHitReflection.a * saturate(exp2(-luminance_diff_scale * luminance(OldHitReflection.rgb - NewReflection.rgb)));
        float  HistoryWorldW = OldWorldReflection.a * saturate(exp2(-luminance_diff_scale * luminance(OldWorldReflection.rgb - NewReflection.rgb)));
		if(NewReflection.w < 1e-1f) {
			// Insufficient new samples found, drop dual blending heuristics from local reflection distribution
			HistoryHitW = 1;
			HistoryWorldW = 1;
		}
		float  DualWeight    = max(HistoryHitW + HistoryWorldW, 1e-7f);
		float3 NeighborSTD   = STDRayDepth.xyz;
		float  Scale = 1.f;
		float3 NeighborMin   = NewReflection.rgb - NeighborSTD * Scale;
		float3 NeighborMax   = NewReflection.rgb + NeighborSTD * Scale;
        float3 DualColor     = (HistoryHitW * clamp(OldHitReflection.rgb, NeighborMin, NeighborMax) +
                                HistoryWorldW * clamp(OldWorldReflection.rgb, NeighborMin, NeighborMax)) / DualWeight;
        float  DualCount     = (HistoryHitW * OldHitReflection.w + HistoryWorldW * OldWorldReflection.w) / DualWeight;
		// Pre-multiply the sample count for later blending
		DenoisedReflection = float4(DualColor * DualCount, DualCount);
	}

	DenoisedReflection += NewReflection;
	// Vignette reflections around the screen (because we've used some screen tracing techniques)
	float MaxSampleCount = 0;
	{
		float2 UV = (PixelCoords + 0.5f) / UB.ScreenDimensions;
		float2 EdgeDistances = UV * (1.0f - UV.yx);
		float  Vignette = pow(15.0f * EdgeDistances.x * EdgeDistances.y, 0.25f);
		MaxSampleCount = clamp(8.0f * UB.Denoiser_Reflection_MaxSampleCount * Vignette, 1.0f, UB.Denoiser_Reflection_MaxSampleCount);
	}
	if(DenoisedReflection.a > MaxSampleCount) {
		float Factor = MaxSampleCount / DenoisedReflection.a;
		DenoisedReflection.rgb *= Factor;
		DenoisedReflection.a = MaxSampleCount;
	}
	g_RWReflectionTexture[PixelCoords] = float4(
		DenoisedReflection.rgb / max(DenoisedReflection.a, 0.5f), // A larger divisor to prevent fireflies
		 DenoisedReflection.a
	);
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void TemporalDenoiseLighting (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	int2 PixelCoords = int2(DispatchID);
	Material M = FetchMaterial(C, PixelCoords);
	if(M.Alpha < UB.OpaqueThreshold) {
		return;
	}
	float PixelZDepth = GetZDepthTexture(C).Load(int3(PixelCoords, 0)).x;
	float2 ScreenPosition = PixelCoords + 0.5f.xx;
	float3 NDC = float3(ScreenToNDC2(ScreenPosition), PixelZDepth);
	float3 PreviousNDC  = ReprojectToPreviousNDCFromNDC(C, NDC);
	float3 ViewDirection = -NDC2ToCameraDirection(C, NDC.xy);
	float4 NewDirectIllumination_C  = GetDirectIlluminationTexture(C).Load(int3(PixelCoords, 0));
	float4 NewIndirectIllumination_Diffuse_C = GetIndirectIlluminationTexture(C).Load(int3(PixelCoords, 0));
	float4 NewFallbackReflection = g_RWFallbackReflectionTexture[PixelCoords];
	// TODO: the normal should be a low frequency one.
	// here the normal is not denoised. Maybe we should use the denoised normal.
	float3 GeometryNormal = normalize(GetNormalTexture(C).Load(int3(PixelCoords, 0)).xyz - 0.5);
	float4 DenoisedDI = NewDirectIllumination_C;
	float4 DenoisedII_Diffuse = NewIndirectIllumination_Diffuse_C;
	float4 DenoisedFallbackReflection = NewFallbackReflection;
	if(all(PreviousNDC.xy >= -1) && all(PreviousNDC.xy <= 1)) {
		float2 PreviousScreenPosition = NDC2ToScreen(PreviousNDC.xy);
		// Make sure the billinear weights are consistent with gathered texels
		float2 HistoryBillinearPos = PreviousScreenPosition - 0.5f;
		float2 HistoryBillinearSubPixel = frac(HistoryBillinearPos);
		float2 HistoryBillinearPixel = floor(HistoryBillinearPos);
		float2 HistoryGatherUV = (HistoryBillinearPixel + 1.f) * C.InvFilmDimensions;
		float4 HistoryZDepths = GetHistoryZDepthTexture(C).GatherRed(g_PointClampSampler, HistoryGatherUV).wzxy;
		float  PrevLinearDepth = ZDepthToLinear(C, PreviousNDC.z);
		float4 HistoryLinearDepths = float4(
			ZDepthToLinear(C, HistoryZDepths.x),
			ZDepthToLinear(C, HistoryZDepths.y),
			ZDepthToLinear(C, HistoryZDepths.z),
			ZDepthToLinear(C, HistoryZDepths.w)
		);
		float4 DepthDistances = abs(HistoryLinearDepths - PrevLinearDepth);
		float  Noise = InterleavedGradientNoise(NDC2ToUV(NDC.xy), UB.FrameIndex);
		float4 DepthThresholds = UB.DI_Denoiser_DepthThreshold * lerp(0.5, 1.5, Noise);
		// UE's resolution for disocclusion misses on geometry edges
		DepthThresholds /= clamp(saturate(dot(ViewDirection, GeometryNormal)), .1f, 1.0f); 
		float4 OcclusionWeights   = select(DepthDistances < PrevLinearDepth * DepthThresholds, 1, 0);
		float4 BillinearWeights = float4(
			(1.f - HistoryBillinearSubPixel.x) * (1.f - HistoryBillinearSubPixel.y),
			HistoryBillinearSubPixel.x * (1.f - HistoryBillinearSubPixel.y),
			(1.f - HistoryBillinearSubPixel.x) * HistoryBillinearSubPixel.y,
			HistoryBillinearSubPixel.x * HistoryBillinearSubPixel.y
		);
		float4 Weights = OcclusionWeights * BillinearWeights;
		Weights = Weights / max(dot(Weights, 1), 1e-6f);

		float3 OldDirectIllumination = 0.f;
		float3 OldIndirectIllumination_Diffuse = 0.f;
		float3 OldFallbackReflection = 0.f;
		Texture2D<float4> HistoryDI = GetHistoryDirectIlluminationTexture(C);
		Texture2D<float4> HistoryII_Diffuse = GetHistoryIndirectIlluminationTexture(C);
		{
			float2 BaseUV = ScreenToUV(HistoryBillinearPixel + 0.5f);
			float3 R00 = HistoryDI.SampleLevel(g_PointClampSampler, BaseUV, 0).rgb;
			float3 R10 = HistoryDI.SampleLevel(g_PointClampSampler, BaseUV + float2(C.FilmTexelSize.x, 0), 0).rgb;
			float3 R01 = HistoryDI.SampleLevel(g_PointClampSampler, BaseUV + float2(0, C.FilmTexelSize.y), 0).rgb;
			float3 R11 = HistoryDI.SampleLevel(g_PointClampSampler, BaseUV + C.FilmTexelSize, 0).rgb;
			OldDirectIllumination = R00 * Weights.x + R10 * Weights.y + R01 * Weights.z + R11 * Weights.w;
		}
		{
			float2 BaseUV = ScreenToUV(HistoryBillinearPixel + 0.5f);
			float3 R00 = HistoryII_Diffuse.SampleLevel(g_PointClampSampler, BaseUV, 0).rgb;
			float3 R10 = HistoryII_Diffuse.SampleLevel(g_PointClampSampler, BaseUV + float2(C.FilmTexelSize.x, 0), 0).rgb;
			float3 R01 = HistoryII_Diffuse.SampleLevel(g_PointClampSampler, BaseUV + float2(0, C.FilmTexelSize.y), 0).rgb;
			float3 R11 = HistoryII_Diffuse.SampleLevel(g_PointClampSampler, BaseUV + C.FilmTexelSize, 0).rgb;
			OldIndirectIllumination_Diffuse = R00 * Weights.x + R10 * Weights.y + R01 * Weights.z + R11 * Weights.w;
		}
			{
			float2 BaseUV = ScreenToUV(HistoryBillinearPixel + 0.5f);
			float3 R00 = g_HistoryFallbackReflectionTexture.SampleLevel(g_PointClampSampler, BaseUV, 0).rgb;
			float3 R10 = g_HistoryFallbackReflectionTexture.SampleLevel(g_PointClampSampler, BaseUV + float2(C.FilmTexelSize.x, 0), 0).rgb;
			float3 R01 = g_HistoryFallbackReflectionTexture.SampleLevel(g_PointClampSampler, BaseUV + float2(0, C.FilmTexelSize.y), 0).rgb;
			float3 R11 = g_HistoryFallbackReflectionTexture.SampleLevel(g_PointClampSampler, BaseUV + C.FilmTexelSize, 0).rgb;
			OldFallbackReflection = R00 * Weights.x + R10 * Weights.y + R01 * Weights.z + R11 * Weights.w;
		}

		float4 HistorySampleCounts_DI = HistoryDI.GatherAlpha(g_PointClampSampler, HistoryGatherUV).wzxy;
		float4 HistorySampleCounts_II_Diffuse = HistoryII_Diffuse.GatherAlpha(g_PointClampSampler, HistoryGatherUV).wzxy;
		float4 HistorySampleCounts_FallbackReflection = g_HistoryFallbackReflectionTexture.GatherAlpha(g_PointClampSampler, HistoryGatherUV).wzxy;
		{
			float NewSampleCount_DI = NewDirectIllumination_C.a;
			float OldSampleCount = dot(HistorySampleCounts_DI * Weights, 1.f.xxxx);
			if(UB.DI_NoTemporalDenoising) {
				OldSampleCount = 0;
			}
			float ClampedOldSampleCount = min(OldSampleCount, max(UB.DI_Denoiser_TargetNumSamples - NewSampleCount_DI, 0));
			float SampleCount = ClampedOldSampleCount + NewSampleCount_DI;
			float BlendingFactor = ClampedOldSampleCount / max(SampleCount, 1e-4f);
			DenoisedDI = float4(
				lerp(NewDirectIllumination_C.rgb, OldDirectIllumination, BlendingFactor),
				SampleCount
			);
		}
		{
			float NewSampleCount_II_Diffuse = NewIndirectIllumination_Diffuse_C.a;
			float OldSampleCount = dot(HistorySampleCounts_II_Diffuse * Weights, 1.f.xxxx);
			if(UB.II_NoTemporalDenoising) {
				OldSampleCount = 0;
			}
			float ClampedOldSampleCount = min(OldSampleCount, max(UB.II_Denoiser_TargetNumSamples - NewSampleCount_II_Diffuse, 0));
			float SampleCount = ClampedOldSampleCount + NewSampleCount_II_Diffuse;
			float BlendingFactor = ClampedOldSampleCount / max(SampleCount, 1e-4f);
			DenoisedII_Diffuse = float4(
				lerp(NewIndirectIllumination_Diffuse_C.rgb, OldIndirectIllumination_Diffuse, BlendingFactor),
				SampleCount
			);
		}
		{
			float NewSampleCount_FallbackReflection = NewFallbackReflection.a;
			float OldSampleCount = dot(HistorySampleCounts_FallbackReflection * Weights, 1.f.xxxx);
			if(UB.FallbackReflection_NoTemporalDenoising) {
				OldSampleCount = 0;
			}
			float ClampedOldSampleCount = min(OldSampleCount, max(UB.FallbackReflection_Denoiser_TargetNumSamples - NewSampleCount_FallbackReflection, 0));
			float SampleCount = ClampedOldSampleCount + NewSampleCount_FallbackReflection;
			float BlendingFactor = ClampedOldSampleCount / max(SampleCount, 1e-4f);
			DenoisedFallbackReflection = float4(
				lerp(NewFallbackReflection.rgb, OldFallbackReflection, BlendingFactor),
				SampleCount
			);
		}
	}
	// Store the results back to the direct illumination buffer
	GetRWFilteredDirectIlluminationTexture(C)[PixelCoords] = DenoisedDI;
	GetRWFilteredIndirectIlluminationTexture(C)[PixelCoords] = DenoisedII_Diffuse;
	g_RWFallbackReflectionTexture[PixelCoords] = DenoisedFallbackReflection;
}

// Temporal denoised DI and II are copied back to the DI & II buffers
 
[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void FinalComposition (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;

	float3 ViewDirection = -NDC2ToCameraDirection(C, FilmToNDC2(C, DispatchID + 0.5f.xx));
	float3 DiffuseCompensation = 1.f;
	Material M = FetchMaterial(C, DispatchID);
	{
		float3 ReflectionDirection = calculateGGXSpecularDirection(M.Normal, ViewDirection, M.Roughness);
		float3 HalfVector_Spec = normalize(ReflectionDirection + ViewDirection);
		float DotSpecHV = saturate(dot(HalfVector_Spec, ViewDirection));
		// Approximate the Fresnel term with the ReflectionDirection as light direction
		// which is the same approximation used by GI1.0
		float3 FresnelTerm = fresnel(M.F0, DotSpecHV);
		DiffuseCompensation = diffuseCompensationTerm(FresnelTerm, DotSpecHV);
	}

	float3 DirectIllumination   = GetDirectIlluminationTexture(C).Load(int3(DispatchID, 0)).rgb;
	float3 IndirectIllumination = GetIndirectIlluminationTexture(C).Load(int3(DispatchID, 0)).rgb;
	float4 RadianceW = 0;

	// Alpha
	RadianceW.w = g_GColorTexture.Load(int3(DispatchID, 0)).a;
	// Force transparent below the opaque threshold
	if(RadianceW.w < UB.OpaqueThreshold) RadianceW.w = 0;
	float4 VisualizeRadianceW = RadianceW;

	// 1. Direct diffuse illumination
	float3 DiffuseBRDF = EvaluateLambertian(M.Albedo);
	float3 DirectDiffuse = DirectIllumination * DiffuseBRDF * DiffuseCompensation;
	RadianceW.rgb += DirectDiffuse;
	if(!UB.NoDirectDiffuseIllumination) {
		VisualizeRadianceW.rgb += DirectDiffuse;
	}
	// 2. Indirect diffuse illumination 
	float3 IndirectDiffuse = IndirectIllumination * DiffuseBRDF * DiffuseCompensation;
	RadianceW.rgb += IndirectDiffuse;
	if(!UB.NoIndirectDiffuseIllumination) {
		VisualizeRadianceW.rgb += IndirectDiffuse;
	}
	// Store intermediate result.
	g_RW_HistoryDiffuseRadianceWithoutEmission[DispatchID] = RadianceW;
	// 3. Glossy/Specular
	float3 Glossy = 0;
	{
		// compute specular term with split-sum approximation
		// 3 levels of reflection to shade from rough to smooth surfaces: irradiance, fallback, fine
		// below LowRoughnessThresh, use fine reflection
		// below MidRoughessThresh, use fine - fallback reflection
		// above MidRoughessThresh, use fallback - irradiance reflection
		float3 Reflection = 0.f;
		float  LowRoughnessThresh = 0.2f;
		float  MidRoughessThresh  = 0.4f;
		float4 FallbackReflection = g_RWFallbackReflectionTexture[DispatchID];
		{
			// Approximate hemispherical incoming radiance by assuming it's a constant.
			// It's dumb...but I have no time to implement a proper approximation. 
			// Paper deardline is coming.
			float3 DirectRadiance   = DirectIllumination / PI;
			FallbackReflection.rgb += DirectRadiance;
		}
		if(M.Roughness < MidRoughessThresh) {
			float4 FineReflection     = g_RWReflectionTexture[DispatchID];
			float MixFactor = saturate((M.Roughness - LowRoughnessThresh) / (MidRoughessThresh - LowRoughnessThresh));
			float WX = FallbackReflection.w * MixFactor;
			float WY = FineReflection.w * (1 - MixFactor);
			MixFactor = WX / max(WX + WY, 1e-4f);
			Reflection = lerp(FineReflection.rgb, FallbackReflection.rgb, MixFactor);
		} else {
			Reflection = FallbackReflection.rgb;
			// TODO mix between irradiance and fallback reflection (from SSRC)
			// No time for that!
		}
		float2 LUT = g_ShadingLUTTexture.SampleLevel(g_LinearClampSampler, 
			float2(saturate(dot(M.Normal, ViewDirection)), M.Roughness
		), 0.0f).xy;
		float3 SpecularAlbedo = saturate(M.F0 * LUT.x + (1.0f - M.F0) * LUT.y);
		Glossy = SpecularAlbedo * Reflection;
	}
	RadianceW.rgb += Glossy;
	if(!UB.NoReflection) {
		VisualizeRadianceW.rgb += Glossy;
	}

	// 4. Emission
	float3 Emission = GetEmissionAlphaTexture(C).Load(int3(DispatchID, 0)).rgb;
	RadianceW.rgb += Emission;
	VisualizeRadianceW.rgb += Emission;

	// Force on 0 lod for sky details
	float3 SkyRadiance = EvaluateSkyRadiance(ViewDirection, 0);
	RadianceW.rgb += SkyRadiance * (1.f - RadianceW.w);
	VisualizeRadianceW.rgb += SkyRadiance * (1.f - RadianceW.w);
	GetRWRadianceTexture(C)[DispatchID] = float4(
		VisualizeRadianceW.rgb,
		1
	);
}

float3 ACESToneMapping(float3 Color, float Exposure)
{
	float A = 2.51f;
	float B = 0.03f;
	float C = 2.43f;
	float D = 0.59f;
	float E = 0.14f;
	Color *= Exposure;
	return (Color * (A * Color + B)) / (Color * (C * Color + D) + E);
}

float3 Relightable3DGSToneMapping (float3 Color) {
    float3 Low = 12.92f * Color;
    float3 High = pow(max(Color, 0.0031308f), 1.0f / 2.4f) * 1.055f - 0.055f;
    return select(Color > 0.0031308, High, Low);
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void ToneMap (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	float2 UV = (DispatchID + 0.5f) / UB.ScreenDimensions;
    float4 Color = g_Radiance.SampleLevel(g_LinearClampSampler, UV, 0);
	// Debugging
	if(UB.DebugMode == 1) {
		Color.rgb = g_GColorTexture.SampleLevel(g_LinearClampSampler, UV, 0).rgb;
    } else if(UB.DebugMode == 2) {
        Color.rgb = g_GMaterialTexture.SampleLevel(g_LinearClampSampler, UV, 0).rrr;
    } else if(UB.DebugMode == 3) {
        Color.rgb = g_GNormalTexture.SampleLevel(g_LinearClampSampler, UV, 0).xyz;
    } else if(UB.DebugMode == 4) {
		float Depth = g_GFilteredDepthTexture.SampleLevel(g_LinearClampSampler, UV, 0).r * 0.2f;
        Color = float4(Depth.xxx, 1);
    } else if(UB.DebugMode == 5) {
        float Alpha = g_GColorTexture.SampleLevel(g_LinearClampSampler, UV, 0).a;
        Color = float4(Alpha.xxx, 1);
    } else if(UB.DebugMode == 8) {
		float3 VColor = g_DebugTexture.SampleLevel(g_LinearClampSampler, UV, 0).rgb;
		Color = float4(VColor, 1);
	} else if(UB.DebugMode == 6) {
        int2 Coords = int2(UV * UB.ScreenDimensions);
        float3 Reflection = g_RWReflectionTexture[Coords].rgb;
        Color = float4(Reflection, 1);
    } else if(UB.DebugMode == 7) {
        int2 Coords = int2(UV * UB.ScreenDimensions);
        float3 Reflection = g_RWFallbackReflectionTexture[Coords].rgb;
        Color = float4(Reflection, 1);
    }
	if(UB.TonemapMode == 0) {
        Color.rgb = ACESToneMapping(Color.rgb, UB.TonemapExposure);
    } else if(UB.TonemapMode == 1) {
        Color.rgb = RadianceToColor(Color.rgb * UB.TonemapExposure);
    } else {
        Color.rgb = Relightable3DGSToneMapping(Color.rgb * UB.TonemapExposure);
    }
	g_RW_MappedRGBA[DispatchID] = Color;
}

// Card kernels
[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void ClearCard (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	int2 TexelCoords = MCUB.CardAtlasBaseCoords.xy + int2(DispatchID);
	int3 AtlasCoords = int3(TexelCoords, MCUB.CardAtlasBaseCoords.z);
	g_RWCardAtlas_ColorTexture[AtlasCoords] = 0;
	g_RWCardAtlas_AlphaTexture[AtlasCoords] = 0;
	g_RWCardAtlas_NormalTexture[AtlasCoords] = 0;
	g_RWCardAtlas_LinearDepthTexture[AtlasCoords] = 0;
	g_RWCardAtlas_DirectIlluminationTexture[AtlasCoords] = 0;
	g_RWCardAtlas_IndirectIlluminationTexture[AtlasCoords] = 0;
	g_RWCardAtlas_LightingTexture[AtlasCoords] = 0;
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void CopyCardToAtlas(uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	int2 TexelCoords = MCUB.CardAtlasBaseCoords.xy + int2(DispatchID);
	int3 AtlasCoords = int3(TexelCoords, MCUB.CardAtlasBaseCoords.z);
	int2 ScreenCoords = int2(DispatchID);
	g_RWCardAtlas_ColorTexture[AtlasCoords].rgb = GetRWColorTexture(C)[ScreenCoords].rgb;
	g_RWCardAtlas_AlphaTexture[AtlasCoords].r = GetRWColorTexture(C)[ScreenCoords].a;
	g_RWCardAtlas_NormalTexture[AtlasCoords].rgb = GetRWNormalTexture(C)[ScreenCoords].rgb;
	g_RWCardAtlas_LinearDepthTexture[AtlasCoords].r = GetRWDepthTexture(C)[ScreenCoords].r;
}

