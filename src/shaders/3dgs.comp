	g_Debug_VisualizeRayVertexBuffer[1] = Origin + Ray.Direction * Ray.RayTMin;
	g_Debug_VisualizeRayRayIndexBuffer[0]  = RayIndex;
}
#endif

// Spawn rays starting from the camera
// For 3DGS HWRT testing purposes only.
// Dispatched 1 group per a small tile
[numthreads(WAVE_SIZE, 1, 1)]
void SpawnCameraRays (uint GroupID : SV_GroupID, uint LocalID : SV_GroupThreadID) {
	if(GroupID == 0 && LocalID == 0) {
		g_RWRayToTraceCountBuffer[0] = UB.ScreenDimensions.x * UB.ScreenDimensions.y;
	}
	// Pack rays in 8x8 small tiles for better cache coherence when tracing a
	// bunch of rays
	int2 TileCoords = int2(GroupID % UB.SmallTileDimensions.x, GroupID / UB.SmallTileDimensions.x);
	for(int TileBaseTexelIndex = 0; TileBaseTexelIndex < SMALL_TILE_SIZE * SMALL_TILE_SIZE; TileBaseTexelIndex += WAVE_SIZE) {
		int TileTexelIndex = TileBaseTexelIndex + LocalID;
		int2 TexelCoords = int2(
			TileTexelIndex % SMALL_TILE_SIZE,
			TileTexelIndex / SMALL_TILE_SIZE
		) + TileCoords * SMALL_TILE_SIZE;
		
		float2 ScreenPosition = float2(TexelCoords) + 0.5f;

		RayToTrace Ray = SpawnCameraRay(GetCameraDescription(), ScreenPosition);
		Ray.Seed = UB.HWRT_StochasticRayTracingQuality * BlueNoise_Sample1D(TexelCoords, UB.FrameIndex);
		int RayIndex = TexelCoords.x + TexelCoords.y * UB.ScreenDimensions.x;
		g_RWRayToTraceListBuffer[RayIndex] = RayIndex;
		WriteRayToTrace(RayIndex, Ray);
	}
}

// Display the camera rays trace results on the screen
[numthreads(WAVE_SIZE, 1, 1)]
void DisplayCameraRays (uint GroupID : SV_GroupID, uint LocalID : SV_GroupThreadID) {
	int2 TileCoords = int2(GroupID % UB.SmallTileDimensions.x, GroupID / UB.SmallTileDimensions.x);
	for(int TileBaseTexelIndex = 0; TileBaseTexelIndex < SMALL_TILE_SIZE * SMALL_TILE_SIZE; TileBaseTexelIndex += WAVE_SIZE) {
		int TileTexelIndex = TileBaseTexelIndex + LocalID;
		int2 TexelCoords = int2(
			TileTexelIndex % SMALL_TILE_SIZE,
			TileTexelIndex / SMALL_TILE_SIZE
		) + TileCoords * SMALL_TILE_SIZE;
		
		int RayIndex = TexelCoords.x + TexelCoords.y * UB.ScreenDimensions.x;
		if(UB.HWRT_VisualizeShadingRays) {
			float4 RayResult = FetchRayTraceResult(RayIndex);
			g_RW_Radiance[TexelCoords] = float4(RayResult.xyz, 1);
		} else if(UB.HWRT_VisualizeStochasticRays) {
			uint2 Result = g_RWRayToTraceResultBuffer[RayIndex];
			RayToTrace R = FetchRayToTrace(RayIndex, UB.RT_MaxTraceDistance, false);
			if(R.bHit) {
				Material M = UnpackCachedMaterial(Result.x);
				g_RW_Radiance[TexelCoords] = float4(M.Albedo, 1);
			} else {
				g_RW_Radiance[TexelCoords] = float4(0, 0, 0, 1);
			}
		} else {
			float  RayT = FetchRayTraceHitT(RayIndex) * 0.2f;
			g_RW_Radiance[TexelCoords] = float4(RayT.xxx, 1);
		}
	}
}

// Visualize surfaces shaded from mesh cards
[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void VisualizeMeshCardScene (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	int2 PixelCoords = int2(DispatchID);
	float2 UV = PixelCoords / C.FilmDimensions;
	float  LinearDepth = GetFilteredDepthTexture(C).Load(int3(PixelCoords, 0)).r;
	if(LinearDepth > 0) {
		float3 WorldPosition = RecoverWorldSpacePosition(C, PixelCoords, LinearDepth);
		float3 ViewDirection = normalize(WorldPosition - C.Position);

		CardSet Cards = FetchCardSet(UB.Debug_CardSetToVisualize);
		float3x4 WorldToInstanceTransform = g_InstanceInvTransformBuffer[UB.Debug_CardSetToVisualize];
		float3x3 WorldToInstanceNormalTransform = g_InstanceNormalTransformBuffer[UB.Debug_CardSetToVisualize];

		CardSampleAccumulator Accumulator = SampleCardSet(
			Cards,
			WorldToInstanceTransform, 
			WorldToInstanceNormalTransform,
			WorldPosition, 
			ViewDirection
		);

		g_RW_DebugTexture[DispatchID] = float4(Accumulator.SolveRadiance(), 1);
	}
	
}

// Inspect card atlas
[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void VisualizeMeshCardAtlas (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	int2 PixelCoords = int2(DispatchID);
	float3 AtlasPosition = float3(
		PixelCoords * UB.Debug_VisualizeMeshCardAtlasScale + UB.Debug_VisualizeMeshCardAtlasOffset,
		UB.Debug_VisualizeMeshCardAtlasLayer
	);
	float3 AtlasSamplePosition = float3(AtlasPosition.xy / CARD_ATLAS_RESOLUTION, AtlasPosition.z);
	if(UB.Debug_VisualizeMeshCardAtlasChannel == 0) {
		g_RW_DebugTexture[PixelCoords] = float4(
			g_CardAtlas_ColorTexture.SampleLevel(g_LinearClampSampler, AtlasSamplePosition, 0).rgb, 1);
	} else if(UB.Debug_VisualizeMeshCardAtlasChannel == 1) {
		g_RW_DebugTexture[PixelCoords] = float4(
			g_CardAtlas_AlphaTexture.SampleLevel(g_LinearClampSampler, AtlasSamplePosition, 0).rrr, 1);
	} else if(UB.Debug_VisualizeMeshCardAtlasChannel == 2) {
		g_RW_DebugTexture[PixelCoords] = float4(
			g_CardAtlas_NormalTexture.SampleLevel(g_LinearClampSampler, AtlasSamplePosition, 0).rgb, 1);
	} else if(UB.Debug_VisualizeMeshCardAtlasChannel == 3) {
		g_RW_DebugTexture[PixelCoords] = float4(
			g_CardAtlas_LinearDepthTexture.SampleLevel(g_LinearClampSampler, AtlasSamplePosition, 0).rrr, 1);
	}
}

uint g_GenerateRTMesh_InstanceIndex;

[numthreads(WAVE_SIZE, 1, 1)]
void GenerateRTMesh (uint DispatchID : SV_DispatchThreadID) {
	int GaussianRank = DispatchID;
	int NumInstanceGaussians = g_InstanceGaussianCountBuffer[g_GenerateRTMesh_InstanceIndex];
	if(GaussianRank >= NumInstanceGaussians) return;
	int GaussianIndex = GaussianRank + g_InstanceGaussianIndexOffsetBuffer[g_GenerateRTMesh_InstanceIndex];

	
	Gaussian G = FetchGaussian(GaussianIndex);
	float4x4 ToWorld = 0;
	{
		float3x3 MS = float3x3(
			float3(G.Scale.x, 0, 0),
			float3(0, G.Scale.y, 0),
			float3(0, 0, G.Scale.z)
		);
		float3x3 MR = EvaluateRotationMatrix(G.Rotation);
		float3x3 M = mul(MR, MS);

		ToWorld = float4x4(
			float4(M[0], G.Position.x),
			float4(M[1], G.Position.y),
			float4(M[2], G.Position.z),
			float4(0.xxx, 1)
		);
	}

	// Magic scaling number mentioned in the paper
	float AlphaMin = UB.HWRT_MinAlphaForGaussianEvaluation;
	float Sigma    = UB.GaussianRTProxyGeometrySigma;
	float MagicScale = sqrt(2 * log(Sigma / max(AlphaMin, 0.001f)));

	const float3 IcoVertices[12] = {
		float3(0.000000, -1.000000, 0.000000),
		float3(0.723600, -0.447215, 0.525720),
		float3(-0.276385, -0.447215, 0.850640),
		float3(-0.894425, -0.447215, 0.000000),
		float3(-0.276385, -0.447215, -0.850640),
		float3(0.723600, -0.447215, -0.525720),
		float3(0.276385, 0.447215, 0.850640),
		float3(-0.723600, 0.447215, 0.525720),
		float3(-0.723600, 0.447215, -0.525720),
		float3(0.276385, 0.447215, -0.850640),
		float3(0.894425, 0.447215, 0.000000),
		float3(0.000000, 1.000000, 0.000000)
	};
	const int3 IcoFaces[20] = {
		int3(0, 1, 2),
		int3(1, 0, 5),
		int3(0, 2, 3),
		int3(0, 3, 4),
		int3(0, 4, 5),
		int3(1, 5, 10),
		int3(2, 1, 6),
		int3(3, 2, 7),
		int3(4, 3, 8),
		int3(5, 4, 9),
		int3(1, 10, 6),
		int3(2, 6, 7),
		int3(3, 7, 8),
		int3(4, 8, 9),
		int3(5, 9, 10),
		int3(6, 10, 11),
		int3(7, 6, 11),
		int3(8, 7, 11),
		int3(9, 8, 11),
		int3(10, 9, 11)
	};

	// Emit the vertices
	int VertexBase = GaussianIndex * 12;
	for(int i = 0; i < 12; i++) {
		float3 Vertex = mul(ToWorld, float4(IcoVertices[i] * MagicScale, 1)).xyz;
		g_RW_RTVertexBuffer[VertexBase + i] = Vertex;
	}
	// Emit the indices
	int IndexBase = GaussianIndex * 60;
	int IndexOffset = GaussianRank * 12;
	for(int i = 0; i < 20; i++) {
		int3 Face = IcoFaces[i];
		g_RW_RTIndexBuffer[IndexBase + i * 3 + 0] = Face.x + IndexOffset;
		g_RW_RTIndexBuffer[IndexBase + i * 3 + 1] = Face.y + IndexOffset;
		g_RW_RTIndexBuffer[IndexBase + i * 3 + 2] = Face.z + IndexOffset;
	}
}
