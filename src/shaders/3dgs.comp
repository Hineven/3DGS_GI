[numthreads(1, 1, 1)]
void InitializeCounters () {
	g_LightGrid_GridLightListAllocator[0] = 0;
}

// Update light headers (mainly grid local positions) for each light 
// Because the grid bounds may be modified by the camera movement and jittering
// also the lights may be moved.
[numthreads(WAVE_SIZE, 1, 1)]
void UpdateLightHeaders (uint DispatchID : SV_DispatchThreadID) {
	uint NumLights = GetNumLights();
	// Ignore the first two lights (directional and sky light)
	if(DispatchID >= NumLights) return;
	int LightIndex = DispatchID;
	LightData LD = FetchLightDetails(LightIndex); 
	Light L = (Light)0;
	L.Type      = LIGHT_TYPE_AREA;
	if(DispatchID == 0) {
		L.Type = LIGHT_TYPE_DIRECTIONAL;
		L.Intensity = Luminance(LD.Radiance);
		L.Normal = normalize(LD.V1);
	} else if(DispatchID == 1) {
		L.Type = LIGHT_TYPE_SKY;
		float SumLuminance = 0;
		// Sample the average radiance of all faces of the sky box
		for(int i = 0; i < 6; i++) {
			float3 Direction = GetSkyBoxDirection(i);
			float3 Radiance = EvaluateSkyRadiance(Direction, 99.f);
			SumLuminance += Luminance(Radiance);
		}
		L.Intensity = SumLuminance / 6 * PI;
	} else {
		float3 WorldCenter = (LD.V1 + LD.V2 + LD.V3) / 3;
		uint4 GridIndex = LightGrid_GetGridIndex(WorldCenter);
		if(IsInvalid(GridIndex.w)) return ;
		float  GridSize;
		float3 GridMin = LightGrid_GetGridBounds(GridIndex, GridSize);
		float3 LocalCenter = saturateDown((WorldCenter - GridMin) / GridSize);
		float Area = length(cross(LD.V2 - LD.V1, LD.V3 - LD.V1)) * 0.5f;
		L.Intensity = Luminance(LD.Radiance) * Area;
		L.GridIndex = GridIndex;
		L.LocalPosition = LocalCenter;
		L.Normal = normalize(cross(LD.V2 - LD.V1, LD.V3 - LD.V1));
	}
	WriteLightHeader(LightIndex, L);
}

[numthreads(WAVE_SIZE, 1, 1)]
void InjectLights (uint DispatchID : SV_DispatchThreadID) {
	uint NumLights = GetNumLights();
	uint4 GridIndex = LightGrid_GetGridIndex(DispatchID);
	if(GridIndex.w >= UB.LightGrid_NumGridCascades) return ;
	float3 GridMin; 
	float GridSize;
	GridMin = LightGrid_GetGridBounds(GridIndex, GridSize);
	float GridLightWeight[LIGHT_GRID_MAX_NUM_GRID_LIGHTS];
	uint  GridLightIndices[LIGHT_GRID_MAX_NUM_GRID_LIGHTS];
	// Bias the initial weight to avoid precision issues
	float GridLightWeightSum = 1e-7f;
	float SampledReservoirsWeightSum = 0.f;
	// Scatter random numbers for RIS.
	Random rng = MakeRandom(9918293 + DispatchID, UB.FrameIndex);
	int LastLight, AcceptedLightCount = 0;
	for(LastLight = 0; LastLight < NumLights && AcceptedLightCount < LIGHT_GRID_MAX_NUM_GRID_LIGHTS; LastLight++) {
		Light L = FetchLightHeader(LastLight);
		float LightWeight = EstimateLightGridContribution(L, GridMin, GridSize);
		if(LightWeight >= UB.LightGrid_MinLightContributionForInjection) {
			GridLightWeight[AcceptedLightCount] = LightWeight;
			GridLightIndices[AcceptedLightCount] = LastLight;
			GridLightWeightSum += LightWeight;
			AcceptedLightCount ++;
		}
	}
	[unroll(LIGHT_GRID_MAX_NUM_GRID_LIGHTS)]
	for(int i = AcceptedLightCount; i < LIGHT_GRID_MAX_NUM_GRID_LIGHTS; i++) {
		GridLightWeight[i] = 0;
		GridLightIndices[i] = 0xffffffffu;
	}
	SampledReservoirsWeightSum = GridLightWeightSum;
	// O(MxN) Brute force algorithm. Assume that there're not many lights
	for(uint ItLightIndex = LastLight; ItLightIndex < NumLights; ItLightIndex ++) {
		Light L = FetchLightHeader(ItLightIndex);
		float LightWeight = EstimateLightGridContribution(L, GridMin, GridSize);
		if(LightWeight >= UB.LightGrid_MinLightContributionForInjection) {
			float NewGridLightWeightSum = GridLightWeightSum + LightWeight;
			float LightAcceptProbability = LightWeight / NewGridLightWeightSum;
			float U = rng.rand();
			if(LightAcceptProbability > U) {
				U = (U - LightAcceptProbability) / (1 - LightAcceptProbability);
				float P = U * SampledReservoirsWeightSum;
				// Multi-reservoir sampling using LightWeight / TotalWeight as target cdf.
				uint LightIndex = ItLightIndex;
				for(int i = 0; i < LIGHT_GRID_MAX_NUM_GRID_LIGHTS; i++) {
					P -= GridLightWeight[i];
					if(P <= 0) {
						SampledReservoirsWeightSum += LightWeight - GridLightWeight[i];
						GridLightWeight[i] = LightWeight;
						GridLightIndices[i] = LightIndex;
						break;
					}
				}
			}
			GridLightWeightSum = NewGridLightWeightSum;
		}
	}
	// Write back
	int NumGridLights = 0;
	for(int i = 0; i < LIGHT_GRID_MAX_NUM_GRID_LIGHTS; i++) {
		if(GridLightIndices[i] != 0xffffffffu) {
			NumGridLights ++;
		} else break;
	}
	int LightGridListIndexBase = 0;
	InterlockedAdd(g_LightGrid_GridLightListAllocator[0], NumGridLights, LightGridListIndexBase);
	g_LightGrid_GridLightListOffsetBuffer[DispatchID] = LightGridListIndexBase;
	// Clamp the number of lights to avoid overflowing the list buffer
	NumGridLights = min(NumGridLights, UB.LightGrid_MaxNumEntries - LightGridListIndexBase);
	g_LightGrid_GridLightCountBuffer[DispatchID] = NumGridLights;
	for(int i = 0; i < NumGridLights; i++) {
		int LightGridListIndex = LightGridListIndexBase + i;
		g_LightGrid_GridLightListBuffer[LightGridListIndex] = GridLightIndices[i];
	}
}

struct LightSample {
	int LightType;
	// If the sampled light is infinitely far, position is replaced by direction.
	float3 Position;
	float  Pdf;
	float3 Radiance;

	bool IsValid () {
		return Pdf > 0;
	}
};

Material FetchMaterial (CameraDescription C, uint2 TexelCoords) {
	Material Result = (Material) 0;
	Result.Normal = GetNormalTexture(C).Load(int3(TexelCoords, 0)).xyz;
	Result.Normal = normalize(Result.Normal * 2 - 1);
	float4 AlbedoAlpha = GetColorTexture(C).Load(int3(TexelCoords, 0));
	Result.Albedo = AlbedoAlpha.xyz;
	Result.Alpha = AlbedoAlpha.w;
	// Result.Roughness = GetRoughnessTexture(TexelCoords).Load().x;
	return Result;
}

LightSample SampleLightWithCosineWeight (float3 Position, Material M, uint LightType, LightData LD, float2 u2) {
	LightSample Result = (LightSample) 0;
	Result.LightType = LightType;
	if(LightType == LIGHT_TYPE_DIRECTIONAL) {
		Result.Position = LD.V1;
		float CosineFactor = saturate(dot(LD.V1, M.Normal));
		Result.Radiance = LD.Radiance * CosineFactor;
		Result.Pdf = 1.f;
	} else if(LightType == LIGHT_TYPE_SKY) {
		Result.Position = SampleSkyLight(M.Normal, u2, Result.Pdf);
		float CosineFactor = saturate(dot(Result.Position, M.Normal));
		Result.Radiance = EvaluateSkyRadiance(-Result.Position) * CosineFactor;
	} else if(LightType == LIGHT_TYPE_AREA) {
		Result.Position = SampleAreaLightArea(LD.V1, LD.V2, LD.V3, u2, Result.Pdf);
		// Convert area pdf to solid angle pdf
		float  Distance = length(Result.Position - Position);
		float3 Direction   = normalize(Result.Position - Position);
		float3 LightNormal = normalize(cross(LD.V2 - LD.V1, LD.V3 - LD.V1));
		float Cosine = dot(LightNormal, -Direction);
		float ReceiverCosine = dot(Direction, M.Normal);
		Result.Pdf *= Distance * Distance / abs(Cosine);
		Result.Radiance = LD.Radiance * saturate(Cosine) * saturate(ReceiverCosine);
	}
	return Result;
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void SampleLightRays (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	// No need to jitter film positions (already done in the rasterization pass via TAA)
	float2 FilmPosition = DispatchID + 0.5f.xx;
	float  LinearDepth  = GetFilteredDepthTexture(C).Load(int3(DispatchID, 0)).r;
	// Empty pixel
	if(LinearDepth == 0) {
		return ;
	}
	float3 Origin = RecoverWorldSpacePosition(C, FilmPosition, LinearDepth);

	// Sample lights using light grid
	uint4 GridIndex      = LightGrid_GetGridIndex(Origin);
	float GridSize;
	float3 GridMin = LightGrid_GetGridBounds(GridIndex, GridSize);
	uint  WaveGridIndex1 = LightGrid_GetGridIndex1(GridIndex);

	if(UB.Debug_VisualizeLightGridCascade && !IsInvalid(GridIndex.w)) {
		int Level = 2;
		bool bInGrid = all(UB.LightGrid_GridCascadeMin[Level].rgb <= Origin) && all(Origin < UB.LightGrid_GridCascadeMax[Level].rgb);
		g_RW_DebugTexture[DispatchID] =  bInGrid ? 1 : 0;//float(1 + GridIndex.w) / UB.LightGrid_NumGridCascades;
	}

	Material M = FetchMaterial(C, DispatchID);

	uint  SampledLightIndex = 0xffffffffu;
	float SampledLightResampleWeight = 0;
	float SumResampleWeights = 0;
	LightSample ReservedSample = (LightSample) 0;
	uint  Seed = DispatchID.x + (DispatchID.y * C.FilmDimensions.x);
	Random rng = MakeRandom(Seed ^ 0x51f49a7cu, UB.FrameIndex);

	// Filter out invalid pixels falling outside of the light grid
	bool bSampled = IsInvalid(GridIndex.w);
	int Iteration = 0;

	// Cooperative sampling
	while(Iteration < 16) {
		uint MinGridIndex1 = WaveActiveMin(bSampled ? 0x7fffffffu : WaveGridIndex1);
		// Sample lights for the pixels within the same light grid with minimum id.
		// Other threads keep idle.
		// It's likely that a tile is covered by a single light grid as light grids are large.
		// So the memory reads can be effectively broadcasted to all threads.
		if(!bSampled && WaveGridIndex1 == MinGridIndex1) {
			float U = rng.rand();
			int NumGridLights = g_LightGrid_GridLightCountBuffer[WaveGridIndex1];
			int LightGridListOffset = g_LightGrid_GridLightListOffsetBuffer[WaveGridIndex1];
			// float GridLightSumWeight = g_LightGrid_GridLightSumWeightBuffer[GridIndex1];
			// Resample grid lights using luminance as the weight
			for(int i = 0; i < NumGridLights; i++) {
				int LightIndex = g_LightGrid_GridLightListBuffer[LightGridListOffset + i];
				Light L = FetchLightHeader(LightIndex);
				// We have to produce a full sample of the light to accurately estimate the light contribution
				LightData   Details = FetchLightDetails(LightIndex);
				// Note: the returned sample is already cosine weighted
				float2 u2 = rng.rand2();
				LightSample Sample  = SampleLightWithCosineWeight(Origin, M, L.Type, Details, u2);
				if(Sample.IsValid()) {
					float LightGridWeight = EstimateLightGridContribution(L, GridMin, GridSize);
					float LightCurrWeight = Luminance(Sample.Radiance / Sample.Pdf); 
					// RIS
					float ResampleWeight  = LightCurrWeight / max(LightGridWeight, 1e-7f);
					if(ResampleWeight > UB.LightGrid_MinResampleWeightForDirectIllumiation) {
						float NewSumResampleWeights = SumResampleWeights + ResampleWeight;
						float CurrentLightU = ResampleWeight / NewSumResampleWeights;
						if(CurrentLightU > U) {
							U /= CurrentLightU;
							ReservedSample = Sample;
							SampledLightResampleWeight = ResampleWeight;
						} else {
							U *= 1.f - CurrentLightU;
						}
						SumResampleWeights = NewSumResampleWeights;
					}
				}
			}
			bSampled = true;
		}
		// All the pixels are sampled. Break.
		if(WaveActiveAllTrue(bSampled)) {
			break;
		}
		Iteration ++;
	}

	// Okay we have a sample for each pixel. Now encode a shadow ray for visibility testing.
	
	if(ReservedSample.IsValid()) {

		// Calculate the real sample contribution. (Picking 1 single light from a bunch of lights)
		// float LightCdf = 1.f / SumResampleWeights;//SampledLightResampleWeight / SumResampleWeights;
		// float LightCdf = 1.f / GetNumLights();
		// float NormalizationFactor = Luminance(ReservedSample.Radiance / ReservedSample.Pdf);
		ReservedSample.Radiance *= SumResampleWeights / (ReservedSample.Pdf * SampledLightResampleWeight);//NormalizationFactor;// * (1.f / LightCdf) / ReservedSample.Pdf;

		// ReservedSample.Radiance = normalize(ReservedSample.Radiance);

		// Spawn shadow ray
		float3 Direction = 0;
		float OcclusionThreshold = 0;
		if(IsInfinitelyFarLightType(ReservedSample.LightType)) {
			Direction = ReservedSample.Position;
			OcclusionThreshold = UB.RT_MaxTraceDistance;
		} else {
			Direction = normalize(ReservedSample.Position - Origin);
			OcclusionThreshold = length(ReservedSample.Position - Origin);
		}
		// Allocate rays
		int RayIndex = 0;
		{
			int RayIndexBase = 0;
			int RayWarpCount = WaveActiveCountBits(1);
			int RayWarpRank  = WavePrefixCountBits(1);
			if(WaveIsFirstLane()) {
				InterlockedAdd(g_RWRayToTraceCountBuffer[0], RayWarpCount, RayIndexBase);
			}
			RayIndexBase = WaveReadLaneFirst(RayIndexBase);
			RayIndex = RayIndexBase + RayWarpRank;
		}
		// Write ray to memory for compound ray tracing
		RayToTrace Ray = InitRayToTrace(UB.RT_MaxTraceDistance);
		// Ray.Origin = Origin;
		Ray.Direction = Direction;
		Ray.Seed = BlueNoise_Sample1D(DispatchID, UB.FrameIndex) * UB.HWRT_StochasticRayTracingQuality;
		WriteRayToTrace(RayIndex, Ray, false);
		g_RWRayToTraceUVPositionBuffer[RayIndex] = PackUnorm16x2(FilmPosition / C.FilmDimensions);
		g_RWRayToTraceListBuffer[RayIndex] = RayIndex;
		// Keep in mind the occulusion threshold for direct illumination visibility testing
		g_RWDirectIlluminationRayOcclusionThresholdBuffer[RayIndex] = OcclusionThreshold;
		// Store the sample contribution for direct illumination (if it passed the visibility test)
		g_RWDirectIlluminationRayContributionBuffer[RayIndex] = PackRadianceA16(float4(ReservedSample.Radiance, 1.f));
	}
}

// Compound ray tracing. Trace rays in screen space first to cull the easy rays 
// and then trace the rest of the rays with 3DGS HWRT.
[numthreads(WAVE_SIZE, 1, 1)]
void TraceRaysInScreenSpace (uint DispatchID : SV_DispatchThreadID) {
	if(DispatchID >= g_RWRayToTraceCountBuffer[0]) return;
	int RayIndex = g_RWRayToTraceListBuffer[DispatchID];
	RayToTrace Ray = FetchRayToTrace(RayIndex, UB.RT_MaxTraceDistance, false);
	// Manually recover the origin from the screen position
	float2 FilmPosition = UnpackUnorm16x2(g_RWRayToTraceUVPositionBuffer[RayIndex])
		 * GetCameraDescription().FilmDimensions;
	float  LinearDepth = GetFilteredDepthTexture(GetCameraDescription()).Load(int3(FilmPosition, 0)).r;
	Ray.Origin = RecoverWorldSpacePosition(GetCameraDescription(), FilmPosition, LinearDepth);
	CameraDescription C = GetCameraDescription();
	
	float3 OriginUVW   = TransformPointWithPerspectiveDivide(C.ProjectionView, Ray.Origin);
	OriginUVW.xy = NDC2ToUV(OriginUVW.xy);
	float3 TexelNormal = normalize(
		2 * GetNormalTexture(C).SampleLevel(g_PointClampSampler, OriginUVW.xy, 0).xyz - 1
	);

	float NormalBias = 0;
	// Bias along the normal to avoid self-intersecting camera facing scene depth texels
	// HZB traversal uses point filtering, so scene depth texels stick out from the plane they are representing
	{
		float2 CornerUV = OriginUVW.xy + .5f * C.FilmTexelSize;
		float3 CornerWorldPosition = RecoverWorldSpacePositionNDC2(C, UVToNDC2(CornerUV), ZDepthToLinear(C, OriginUVW.z));
		// Project texel corner onto normal
		NormalBias = abs(dot(CornerWorldPosition - Ray.Origin, TexelNormal)) * 2;
	}

	float3 BiasedOrigin = Ray.Origin + NormalBias * TexelNormal;
	float3 RayStartUVW  = TransformPointWithPerspectiveDivide(C.ProjectionView, BiasedOrigin);
	RayStartUVW.xy = NDC2ToUV(RayStartUVW.xy);
	// Skip screen traces if the normal bias pushed our starting point off-screen, as TraceScreen() doesn't handle this
	if (any(RayStartUVW.xy < 0) || any(RayStartUVW.xy >= 1)) {
		return;
	}
	
	bool bHit;
	float3 HitUVW;
	float3 LastVisibleUVW;
	float Unused;

	float MaxTraceDistance = UB.SSRT_MaxTraceDistance;
	float RelativeTexelThickness = UB.SSRT_RelativeTexelThickness;

	ScreenSpaceRayTrace(
		C,
		GetZDepthTexture(C),
		GetNearHZBTexture(C),
		BiasedOrigin,
		Ray.Direction,
		// normalize(float3(0, 1, 1)),
		MaxTraceDistance, 
		UB.SSRT_MaxNumIterations,
		RelativeTexelThickness,
		0,
		bHit,
		HitUVW,
		LastVisibleUVW,
		Unused
	);

	float3 HitWorldPosition = RecoverWorldSpacePositionNDC2(C, UVToNDC2(HitUVW.xy), ZDepthToLinear(C, HitUVW.z));
	float HitDistance = min(length(HitWorldPosition - BiasedOrigin), MaxTraceDistance);

	if (bHit)
	{
		float2 NoiseUV = float2(
			RayIndex % 1024,
			RayIndex / 1024
		) + 0.5f.xx;
		float Noise = InterleavedGradientNoise(NoiseUV, UB.FrameIndex);
		// No vignetting for screen traces for now.
		if (bHit)
		{
			float3 PreviousUVW = ReprojectToPreviousUVWFromUVW(C, HitUVW);
			if(all(PreviousUVW.xy >= 0) && all(PreviousUVW.xy < 1)) {
				// Calculate the expected depth of the pixel last frame
				float PrevZDepth  = PreviousUVW.z;

				// Lookup the actual depth at the same screen position last frame
				float HistoryZDepth = GetHistoryZDepthTexture(C).SampleLevel(g_PointClampSampler, PreviousUVW.xy, 0).x;

				bHit = abs(HistoryZDepth - PrevZDepth) < RelativeTexelThickness * 0.5f * lerp(.5f, 2.0f, Noise);
			}
		}

		if (bHit)
		{
			float3 PreviousUVW = ReprojectToPreviousUVWFromUVW(C, HitUVW);
			if(all(PreviousUVW.xy >= 0) && all(PreviousUVW.xy < 1)) {
				float3 Radiance = GetHistoryRadianceTexture(C).SampleLevel(g_PointClampSampler, PreviousUVW.xy, 0).xyz;
				g_RWRayToTraceResultBuffer[RayIndex] = PackFp16x4Safe(float4(Radiance, 0));
			}
		}
	}

	// Remember to reduce the texel relative thickness on SSRT if there're too many false hits.
	
	WriteRayTraceFlags(RayIndex, bHit, HitDistance);
}

[numthreads(WAVE_SIZE, 1, 1)]
void CompactRayTraces (uint DispatchID : SV_DispatchThreadID) {
	if(DispatchID >= g_RWRayToTraceCountBuffer[0]) return;
	int RayIndex = g_RWRayToTraceListBuffer[DispatchID];
	// Compact only happens after screen space ray tracing, so we dont need to fetch ray origins.
	RayToTrace Ray = FetchRayToTrace(RayIndex, UB.RT_MaxTraceDistance, false);
	if(!Ray.bHit) {
		int RayCount = WaveActiveCountBits(1);
		int RayWarpRank  = WavePrefixCountBits(1);
		int RayBaseRank = 0;
		if(WaveIsFirstLane()) {
			InterlockedAdd(g_RWCompactedRayToTraceCountBuffer[0], RayCount, RayBaseRank);
		}
		RayBaseRank = WaveReadLaneFirst(RayBaseRank);
		int NewRayRank = RayBaseRank + RayWarpRank;
		g_RWCompactedRayToTraceListBuffer[NewRayRank] = RayIndex;
		// Backward a little bit for ray continuation.
		// FIXME
		// float RayTMinBiased = max(Ray.RayTMin * 0.4f, Ray.RayTMin - 0.4f);
		float RayTMinBiased = Ray.RayTMin;
		WriteRayTraceFlags(RayIndex, Ray.bHit, RayTMinBiased);
	}
}

[numthreads(WAVE_SIZE, 1, 1)]
void ResolveDirectLighting (uint DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(DispatchID >= g_RWRayCountBuffer[0]) return;

	// Splat ray origins onto the film
	int RayIndex = DispatchID;
	RayToTrace Ray = FetchRayToTrace(RayIndex, UB.RT_MaxTraceDistance, false);
	float2 FilmPosition = UnpackUnorm16x2(g_RWRayToTraceUVPositionBuffer[RayIndex]) * C.FilmDimensions;
	int2   PixelCoords  = int2(FilmPosition);

#ifndef NDEBUG
	{
		// Build the mapping from pixel to ray index for debugging
		int PixelIndex = PixelCoords.x + PixelCoords.y * C.FilmDimensions.x;
		g_Debug_DirectIlluminationPixelRayIndexBuffer[PixelIndex] = RayIndex;
	}
#endif
	
	if(IsOutOfFilm(C, PixelCoords)) return;

	Material M = FetchMaterial(C, PixelCoords);

	// Transparent
	if(M.Alpha < UB.OpaqueThreshold) {
		GetRWDirectIlluminationTexture(C)[PixelCoords] = 0.f.xxxx;
		return;
	}

	float  Threshold = g_RWDirectIlluminationRayOcclusionThresholdBuffer[RayIndex];
	float  Noise = BlueNoise_Sample1D(PixelCoords, UB.FrameIndex, 1);
	Threshold *= lerp(UB.DI_OcclusionThresholdMinFactor, UB.DI_OcclusionThresholdMaxFactor, Noise);
	float3 Radiance = UnpackRadianceA16(g_RWDirectIlluminationRayContributionBuffer[RayIndex]).xyz;
	Radiance *= (Threshold < Ray.RayTMin) ? 1 : 0;

	GetRWDirectIlluminationTexture(C)[PixelCoords] = float4(Radiance, 1);
	// Pixels with no valid samples will have a sample count of 0.
}

// Similar to Lumen
float GetFilterPositionWeight(float NeighborLinearDepth, float LinearDepth)
{
	float DepthDifference = abs(NeighborLinearDepth - LinearDepth);
	float RelativeDepthDifference = DepthDifference / LinearDepth;
	return exp2(-1000.f * (RelativeDepthDifference * RelativeDepthDifference));
}

// Used to specify the filter pass
// Hard coded 2 pass a-trous filter for now.
#ifndef FILTER_PASS
#define FILTER_PASS 0
#endif

#ifndef FILTER_RADIUS
#define FILTER_RADIUS 2
#endif

float NormalWeight (float3 NormalA, float3 NormalB) {
	return pow(saturate(dot(NormalA, NormalB)), 4);

}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void SpatialFilterDirectIllumination (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	int2 PixelCoords = int2(DispatchID);
	Material M = FetchMaterial(C, PixelCoords);
	if(M.Alpha < UB.OpaqueThreshold) {
		return;
	}
	float  PixelLinearDepth = GetFilteredDepthTexture(C).Load(int3(PixelCoords, 0)).r;
	float3 PixelNormal = normalize(GetNormalTexture(C).Load(int3(PixelCoords, 0)).xyz - 0.5f);
	float3 SumRadiance = 0;
	float SumWeight = 0;

#if FILTER_PASS == 0
	Texture2D<float4> Input = GetDirectIlluminationTexture(C);
#else
	Texture2D<float4> Input = GetFilteredDirectIlluminationTexture(C);
#endif

	int StepSize = 1 << FILTER_PASS;

	// int Count = 2 * UB.DI_FilterRadius * (UB.DI_FilterRadius + 1) + 1;
	for(int dy = -FILTER_RADIUS; dy <= FILTER_RADIUS; dy++) {
		int L = FILTER_RADIUS - abs(dy);
		for(int dx = -L; dx <= L; dx ++) {
			int2 Offset = int2(dx, dy) * StepSize;
			int2 TexelCoords = PixelCoords + Offset;
			if(IsOutOfFilm(C, TexelCoords)) continue;
			float  NeighborLinearDepth = GetFilteredDepthTexture(C).Load(int3(TexelCoords, 0)).r;
			float3 NeighborNormal = normalize(GetNormalTexture(C).Load(int3(TexelCoords, 0)).xyz - 0.5f);
			bool   bIsNeightborTransparent = NeighborLinearDepth == 0;
			float3 NeighborRadiance = Input.Load(int3(TexelCoords, 0)).rgb;
			float Weight = GetFilterPositionWeight(NeighborLinearDepth, PixelLinearDepth);
			float GaussianKernelWeight = exp(-dot(Offset, Offset) * UB.DI_InvFilterGaussianRadius2);
			Weight *= GaussianKernelWeight;
			Weight *= NormalWeight(PixelNormal, NeighborNormal);
			Weight *= bIsNeightborTransparent ? 0 : 1;

			SumRadiance += NeighborRadiance * Weight;
			SumWeight += Weight;
		}
	}
#if FILTER_PASS == 0
	RWTexture2D<float4> Output = GetRWFilteredDirectIlluminationTexture(C);
#else
	RWTexture2D<float4> Output = GetRWDirectIlluminationTexture(C);
#endif
	Output[PixelCoords] = float4(SumRadiance / SumWeight, SumWeight);
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void TemporalFilterDirectIllumination (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	int2 PixelCoords = int2(DispatchID);
	Material M = FetchMaterial(C, PixelCoords);
	if(M.Alpha < UB.OpaqueThreshold) {
		return;
	}
	float PixelZDepth = GetZDepthTexture(C).Load(int3(PixelCoords, 0)).x;
	float2 ScreenPosition = PixelCoords + 0.5f.xx;
	float3 NDC = float3(ScreenToNDC2(ScreenPosition), PixelZDepth);
	float3 PreviousNDC  = ReprojectToPreviousNDCFromNDC(C, NDC);
	float3 ViewDirection = NDC2ToCameraDirection(C, NDC.xy);
	float4 NewLightingC  = GetDirectIlluminationTexture(C).Load(int3(PixelCoords, 0));
	// TODO the normal should be a low frequency one.
	// here the normal is not denoised. Maybe we should use the denoised normal.
	float3 GeometryNormal = normalize(GetNormalTexture(C).Load(int3(PixelCoords, 0)).xyz - 0.5);
	float4 Denoised = NewLightingC;
	if(all(PreviousNDC.xy >= -1) && all(PreviousNDC.xy <= 1)) {
		float2 PreviousScreenPosition = NDC2ToScreen(PreviousNDC.xy);
		// Make sure the billinear weights are consistent with gathered texels
		float2 HistoryBillinearPos = PreviousScreenPosition - 0.5f;
		float2 HistoryBillinearSubPixel = frac(HistoryBillinearPos);
		float2 HistoryBillinearPixel = floor(HistoryBillinearPos);
		float2 HistoryGatherUV = (HistoryBillinearPixel + 1.f) * C.InvFilmDimensions;
		float4 HistoryZDepths = GetHistoryZDepthTexture(C).GatherRed(g_PointClampSampler, HistoryGatherUV).wzxy;
		float  PrevLinearDepth = ZDepthToLinear(C, PreviousNDC.z);
		float4 HistoryLinearDepths = float4(
			ZDepthToLinear(C, HistoryZDepths.x),
			ZDepthToLinear(C, HistoryZDepths.y),
			ZDepthToLinear(C, HistoryZDepths.z),
			ZDepthToLinear(C, HistoryZDepths.w)
		);
		float4 DepthDistances = abs(HistoryLinearDepths - PrevLinearDepth);
		float  Noise = InterleavedGradientNoise(NDC2ToUV(NDC.xy), UB.FrameIndex);
		float4 DepthThresholds = UB.DI_Denoiser_DepthThreshold * lerp(0.5, 1.5, Noise);
		// UE's resolution for disocclusion misses on geometry edges
		DepthThresholds /= clamp(saturate(dot(ViewDirection, GeometryNormal)), .1f, 1.0f); 
		float4 OcclusionWeights   = select(DepthDistances < PrevLinearDepth * DepthThresholds, 1, 0);
		float4 BillinearWeights = float4(
			(1.f - HistoryBillinearSubPixel.x) * (1.f - HistoryBillinearSubPixel.y),
			HistoryBillinearSubPixel.x * (1.f - HistoryBillinearSubPixel.y),
			(1.f - HistoryBillinearSubPixel.x) * HistoryBillinearSubPixel.y,
			HistoryBillinearSubPixel.x * HistoryBillinearSubPixel.y
		);
		float4 Weights = OcclusionWeights * BillinearWeights;
		Weights = Weights / max(dot(Weights, 1), 1e-6f);

		float3 OldLighting = 0.f;
		Texture2D<float4> HistoryDI = GetHistoryDirectIlluminationTexture(C);
		{
			float2 BaseUV = ScreenToUV(HistoryBillinearPixel + 0.5f);
			float3 R00 = HistoryDI.SampleLevel(g_PointClampSampler, BaseUV, 0).rgb;
			float3 R10 = HistoryDI.SampleLevel(g_PointClampSampler, BaseUV + float2(C.FilmTexelSize.x, 0), 0).rgb;
			float3 R01 = HistoryDI.SampleLevel(g_PointClampSampler, BaseUV + float2(0, C.FilmTexelSize.y), 0).rgb;
			float3 R11 = HistoryDI.SampleLevel(g_PointClampSampler, BaseUV + C.FilmTexelSize, 0).rgb;
			OldLighting = R00 * Weights.x + R10 * Weights.y + R01 * Weights.z + R11 * Weights.w;
		}

		float4 HistorySampleCounts = HistoryDI.GatherAlpha(g_PointClampSampler, HistoryGatherUV).wzxy;
		float NewSampleCount = NewLightingC.a;
		float OldSampleCount = dot(HistorySampleCounts * Weights, 1.f.xxxx);
		if(UB.DI_NoTemporalDenoising) {
			OldSampleCount = 0;
		}
		float ClampedOldSampleCount = min(OldSampleCount, max(UB.DI_Denoiser_TargetNumSamples - NewSampleCount, 0));
		float SampleCount = ClampedOldSampleCount + NewSampleCount;
		float BlendingFactor = ClampedOldSampleCount / SampleCount;
		Denoised = float4(
			lerp(NewLightingC.rgb, OldLighting, BlendingFactor),
			SampleCount
		);
	}
	// Store the results back to the direct illumination buffer
	GetRWFilteredDirectIlluminationTexture(C)[PixelCoords] = Denoised;
}

// Filtered DI is copied back to the DI buffer

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void FinalComposition (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	float3 DirectIllumination = GetDirectIlluminationTexture(C).Load(int3(DispatchID, 0)).rgb;
	float4 RadianceW = 0;

	// Alpha
	// Slightly increases the alpha value to prevent skylight leaking from the background
	RadianceW.w = saturate(g_GColorTexture.Load(int3(DispatchID, 0)).a + 0.03f);

	// 0. Emission
	float3 Emission = GetEmissionAlphaTexture(C).Load(int3(DispatchID, 0)).rgb;
	RadianceW.rgb += Emission;

	// 1. Direct illumination
	Material M = FetchMaterial(C, DispatchID);
	RadianceW.rgb += DirectIllumination * M.Albedo;

	// 2. Indirect illumination (todo)
	// ...

	// Debugging
	if(UB.DebugMode == 1) {
		RadianceW.rgb = ColorToRadiance(g_GColorTexture.Load(int3(DispatchID, 0)).rgb);
    } else if(UB.DebugMode == 2) {
        RadianceW.rgb = g_GMaterialTexture.Load(int3(DispatchID, 0)).rrr;
    } else if(UB.DebugMode == 3) {
        RadianceW.rgb = g_GNormalTexture.Load(int3(DispatchID, 0)).xyz;
    } else if(UB.DebugMode == 4) {
		float Depth = g_GDepthTexture.Load(int3(DispatchID, 0)).r * 0.2f;
        RadianceW = float4(Depth.xxx, 1);
    } else if(UB.DebugMode == 5) {
        float Alpha = g_GColorTexture.Load(int3(DispatchID, 0)).a;
        RadianceW = float4(Alpha.xxx, 1);
    } else if(UB.DebugMode == 6) {
		float3 Color = g_DebugTexture.Load(int3(DispatchID, 0)).rgb;
		RadianceW = float4(Color.xxx, 1);
	}
	float3 ViewDirection = -NDC2ToCameraDirection(C, FilmToNDC2(C, DispatchID + 0.5f.xx));
	float3 SkyRadiance = EvaluateSkyRadiance(ViewDirection);
	GetRWRadianceTexture(C)[DispatchID] = float4(
		RadianceW.rgb + SkyRadiance * (1.f - RadianceW.w),
		1
	);
}

// Card kernels
[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void ClearCard (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	int2 TexelCoords = MCUB.CardAtlasBaseCoords.xy + int2(DispatchID);
	int3 AtlasCoords = int3(TexelCoords, MCUB.CardAtlasBaseCoords.z);
	g_RWCardAtlas_ColorTexture[AtlasCoords] = 0;
	g_RWCardAtlas_AlphaTexture[AtlasCoords] = 0;
	g_RWCardAtlas_NormalTexture[AtlasCoords] = 0;
	g_RWCardAtlas_LinearDepthTexture[AtlasCoords] = 0;
	g_RWCardAtlas_DirectIlluminationTexture[AtlasCoords] = 0;
	g_RWCardAtlas_IndirectIlluminationTexture[AtlasCoords] = 0;
	g_RWCardAtlas_LightingTexture[AtlasCoords] = 0;
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void CopyCardToAtlas(uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	int2 TexelCoords = MCUB.CardAtlasBaseCoords.xy + int2(DispatchID);
	int3 AtlasCoords = int3(TexelCoords, MCUB.CardAtlasBaseCoords.z);
	int2 ScreenCoords = int2(DispatchID);
	g_RWCardAtlas_ColorTexture[AtlasCoords].rgb = GetRWColorTexture(C)[ScreenCoords].rgb;
	g_RWCardAtlas_AlphaTexture[AtlasCoords].r = GetRWColorTexture(C)[ScreenCoords].a;
	g_RWCardAtlas_NormalTexture[AtlasCoords].rgb = GetRWNormalTexture(C)[ScreenCoords].rgb;
	g_RWCardAtlas_LinearDepthTexture[AtlasCoords].r = GetRWDepthTexture(C)[ScreenCoords].r;
}

#ifndef NDEBUG
[numthreads(1, 1, 1)]
void Debug_PrepareVisualizeDIRay () {
	int2 PixelCoords = UB.Debug_CursorPixelCoords;
	Material M = FetchMaterial(GetCameraDescription(), PixelCoords);
	if(!IsMaterialValid(M)) {
		// No rays to visualize
		g_Debug_VisualizeRayCountBuffer[0] = 0;
		return ;
	}
	int RayIndex = g_Debug_DirectIlluminationPixelRayIndexBuffer[PixelCoords.x + PixelCoords.y * UB.ScreenDimensions.x];
	if(RayIndex == 0xffffffffu) {
		// No rays to visualize
		g_Debug_VisualizeRayCountBuffer[0] = 0;
		return ;
	}
	g_Debug_VisualizeRayCountBuffer[0] = 1;
	RayToTrace Ray = FetchRayToTrace(RayIndex, UB.RT_MaxTraceDistance, false);
	float LinearDepth = GetFilteredDepthTexture(GetCameraDescription()).Load(int3(PixelCoords, 0)).r;
	float3 Origin = RecoverWorldSpacePosition(GetCameraDescription(), PixelCoords, LinearDepth);
	g_Debug_VisualizeRayVertexBuffer[0] = Origin;
	g_Debug_VisualizeRayVertexBuffer[1] = Origin + Ray.Direction * Ray.RayTMin;
	g_Debug_VisualizeRayRayIndexBuffer[0]  = RayIndex;
}
#endif

// Spawn rays starting from the camera
// For 3DGS HWRT testing purposes only.
// Dispatched 1 group per a small tile
[numthreads(WAVE_SIZE, 1, 1)]
void SpawnCameraRays (uint GroupID : SV_GroupID, uint LocalID : SV_GroupThreadID) {
	if(GroupID == 0 && LocalID == 0) {
		g_RWRayToTraceCountBuffer[0] = UB.ScreenDimensions.x * UB.ScreenDimensions.y;
	}
	// Pack rays in 8x8 small tiles for better cache coherence when tracing a
	// bunch of rays
	int2 TileCoords = int2(GroupID % UB.SmallTileDimensions.x, GroupID / UB.SmallTileDimensions.x);
	for(int TileBaseTexelIndex = 0; TileBaseTexelIndex < SMALL_TILE_SIZE * SMALL_TILE_SIZE; TileBaseTexelIndex += WAVE_SIZE) {
		int TileTexelIndex = TileBaseTexelIndex + LocalID;
		int2 TexelCoords = int2(
			TileTexelIndex % SMALL_TILE_SIZE,
			TileTexelIndex / SMALL_TILE_SIZE
		) + TileCoords * SMALL_TILE_SIZE;
		
		float2 ScreenPosition = float2(TexelCoords) + 0.5f;

		RayToTrace Ray = SpawnCameraRay(UB.MainCamera, ScreenPosition);
		Ray.Seed = UB.HWRT_StochasticRayTracingQuality * BlueNoise_Sample1D(TexelCoords, UB.FrameIndex);
		int RayIndex = TexelCoords.x + TexelCoords.y * UB.ScreenDimensions.x;
		g_RWRayToTraceListBuffer[RayIndex] = RayIndex;
		WriteRayToTrace(RayIndex, Ray);
	}
}

// Display the camera rays trace results on the screen
[numthreads(WAVE_SIZE, 1, 1)]
void DisplayCameraRays (uint GroupID : SV_GroupID, uint LocalID : SV_GroupThreadID) {
	int2 TileCoords = int2(GroupID % UB.SmallTileDimensions.x, GroupID / UB.SmallTileDimensions.x);
	for(int TileBaseTexelIndex = 0; TileBaseTexelIndex < SMALL_TILE_SIZE * SMALL_TILE_SIZE; TileBaseTexelIndex += WAVE_SIZE) {
		int TileTexelIndex = TileBaseTexelIndex + LocalID;
		int2 TexelCoords = int2(
			TileTexelIndex % SMALL_TILE_SIZE,
			TileTexelIndex / SMALL_TILE_SIZE
		) + TileCoords * SMALL_TILE_SIZE;
		
		int RayIndex = TexelCoords.x + TexelCoords.y * UB.ScreenDimensions.x;
		if(UB.VisualizeShadingRays) {
			float4 RayResult = FetchRayTraceResult(RayIndex);
			g_RW_Radiance[TexelCoords] = float4(RayResult.xyz, 1);
		} else {
			float  RayT = FetchRayTraceHitT(RayIndex) * 0.2f;
			g_RW_Radiance[TexelCoords] = float4(RayT.xxx, 1);
		}
	}
}

[numthreads(WAVE_SIZE, 1, 1)]
void GenerateRTMesh (uint DispatchID : SV_DispatchThreadID) {
	int GaussianIndex = DispatchID;
	if(GaussianIndex >= UB.NumGaussians) return ;
	
	Gaussian G = FetchGaussian(GaussianIndex);
	float4x4 ToWorld = 0;
	{
		float3x3 MS = float3x3(
			float3(G.Scale.x, 0, 0),
			float3(0, G.Scale.y, 0),
			float3(0, 0, G.Scale.z)
		);
		float3x3 MR = EvaluateRotationMatrix(G.Rotation);
		float3x3 M = mul(MR, MS);

		ToWorld = float4x4(
			float4(M[0], G.Position.x),
			float4(M[1], G.Position.y),
			float4(M[2], G.Position.z),
			float4(0.xxx, 1)
		);
	}

	// Magic scaling number mentioned in the paper
	float AlphaMin = UB.HWRT_MinAlphaForGaussianEvaluation;
	float Sigma    = UB.GaussianRTProxyGeometrySigma;
	float MagicScale = sqrt(2 * log(Sigma / max(AlphaMin, 0.001f)));

	const float3 IcoVertices[12] = {
		float3(0.000000, -1.000000, 0.000000),
		float3(0.723600, -0.447215, 0.525720),
		float3(-0.276385, -0.447215, 0.850640),
		float3(-0.894425, -0.447215, 0.000000),
		float3(-0.276385, -0.447215, -0.850640),
		float3(0.723600, -0.447215, -0.525720),
		float3(0.276385, 0.447215, 0.850640),
		float3(-0.723600, 0.447215, 0.525720),
		float3(-0.723600, 0.447215, -0.525720),
		float3(0.276385, 0.447215, -0.850640),
		float3(0.894425, 0.447215, 0.000000),
		float3(0.000000, 1.000000, 0.000000)
	};
	const int3 IcoFaces[20] = {
		int3(0, 1, 2),
		int3(1, 0, 5),
		int3(0, 2, 3),
		int3(0, 3, 4),
		int3(0, 4, 5),
		int3(1, 5, 10),
		int3(2, 1, 6),
		int3(3, 2, 7),
		int3(4, 3, 8),
		int3(5, 4, 9),
		int3(1, 10, 6),
		int3(2, 6, 7),
		int3(3, 7, 8),
		int3(4, 8, 9),
		int3(5, 9, 10),
		int3(6, 10, 11),
		int3(7, 6, 11),
		int3(8, 7, 11),
		int3(9, 8, 11),
		int3(10, 9, 11)
	};

	// Emit the vertices
	int VertexBase = GaussianIndex * 12;
	for(int i = 0; i < 12; i++) {
		float3 Vertex = mul(ToWorld, float4(IcoVertices[i] * MagicScale, 1)).xyz;
		g_RW_RTVertexBuffer[VertexBase + i] = Vertex;
	}
	// Emit the indices
	int IndexBase = GaussianIndex * 60;
	int IndexOffset = GaussianIndex * 12;
	for(int i = 0; i < 20; i++) {
		int3 Face = IcoFaces[i];
		g_RW_RTIndexBuffer[IndexBase + i * 3 + 0] = Face.x + IndexOffset;
		g_RW_RTIndexBuffer[IndexBase + i * 3 + 1] = Face.y + IndexOffset;
		g_RW_RTIndexBuffer[IndexBase + i * 3 + 2] = Face.z + IndexOffset;
	}
}