[numthreads(1, 1, 1)]
void GenerateDispatchRaysIndirect () {
	DispatchRaysIndirectCommand Cmd = (DispatchRaysIndirectCommand)0;
	Cmd.RayGenerationShaderRecord = UB.RT_RayGenerationShaderRecord;
	Cmd.MissShaderTable = UB.RT_MissShaderTable;
	Cmd.HitGroupTable = UB.RT_HitGroupTable;
	Cmd.CallableShaderTable = UB.RT_CallableShaderTable;
	Cmd.Width  = g_RaysToDispatchCountBuffer[0];
	Cmd.Height = 1;
	Cmd.Depth  = 1;
	g_RWDispatchRaysIndirectCommandBuffer[0] = Cmd;
}

[numthreads(1, 1, 1)]
void GenerateDispatchIndirect () {
	DispatchIndirectCommand Cmd = (DispatchIndirectCommand)0;

	Cmd.ThreadGroupCountX = (g_ThreadsToDispatchCountBuffer[0] + UB.IndirectThreadGroupSize - 1) / UB.IndirectThreadGroupSize;
	Cmd.ThreadGroupCountY = 1;
	Cmd.ThreadGroupCountZ = 1;
	g_RWDispatchIndirectCommandBuffer[0] = Cmd;
}

[numthreads(1, 1, 1)]
void GenerateDrawIndirect () {
	DrawIndirectCommand Cmd = (DrawIndirectCommand)0;
	Cmd.VertexCount = g_VertexToDrawCountBuffer[0];
	Cmd.InstanceCount = 1;
	Cmd.StartVertex = 0;
	Cmd.StartInstance = 0;
	g_RWDrawIndirectCommandBuffer[0] = Cmd;
}

uint4 GetOverlappingTiles (float2 ScreenPosition, float Radius) {
	float2 MinTexCoords = ScreenPosition - Radius;
	float2 MaxTexCoords = ScreenPosition + Radius;
	// Convert to tile coords
	int2 MinTileCoords = floor(MinTexCoords / TILE_SIZE);
	int2 MaxTileCoords = ceil(MaxTexCoords  / TILE_SIZE);
	MinTileCoords = clamp(MinTileCoords, 0, UB.TileDimensions);
	MaxTileCoords = clamp(MaxTileCoords, 0, UB.TileDimensions);
	return uint4(MinTileCoords, MaxTileCoords);
}

[numthreads(WAVE_SIZE, 1, 1)]
void ClearCounters () {
	g_RWActiveGaussianCountBuffer[0] = 0;
	g_RWProbeUpdateRayHitShadeCountBuffer[0] = 0;
	g_HashGrids_ActiveTileCountBuffer[0] = 0;
	g_HashGrids_UpdateTileCountBuffer[0] = 0;
	g_RWAdaptiveProbeCountBuffer[0] = 0;
}

// Manually set by dispatches
uint g_FilterActiveGaussians_CurrentInstanceIndex;

// Filter the active gaussians that are visible in the view frustrum
[numthreads(WAVE_SIZE, 1, 1)]
void FilterActiveGaussians (uint DispatchID : SV_DispatchThreadID) {

	// OPTIMIZE: also filter out the gaussians that failed the visibility test
	// for RasterizationDepth and history depth buffer.
#ifdef CARD_SHADERS
	uint InstanceIndex = MCUB.CardSetIndex;
	uint InstanceBaseGaussianIndex = g_InstanceGaussianIndexOffsetBuffer[InstanceIndex];
	uint InstanceNumGaussians = g_InstanceGaussianCountBuffer[InstanceIndex];
	if(DispatchID >= InstanceNumGaussians) return;
	uint GaussianIndex = InstanceBaseGaussianIndex + DispatchID;
	float3x4 Transform = g_InstanceTransformBuffer[InstanceIndex];
#else
	uint InstanceIndex = g_FilterActiveGaussians_CurrentInstanceIndex;
	uint InstanceBaseGaussianIndex = g_InstanceGaussianIndexOffsetBuffer[InstanceIndex];
	uint InstanceNumGaussians = g_InstanceGaussianCountBuffer[InstanceIndex];
	if(DispatchID >= InstanceNumGaussians) return ;
	uint GaussianIndex = InstanceBaseGaussianIndex + DispatchID;
	float3x4 Transform = g_InstanceTransformBuffer[InstanceIndex];
#endif

    Gaussian G = FetchGaussian(GaussianIndex);
	float3 TransformedPosition = TransformPoint(Transform, G.Position);


	float3 ViewSpacePosition = 0;
	// We only clip gaussians by their positions in this pass.
	if(IsPointInFrustrum(
		GetCameraDescription(), TransformedPosition, ViewSpacePosition,
		 false, GetCameraDescription().NearPlane, 0.1f
	)) {
		int GaussianCount = WaveActiveCountBits(1);
		int GaussianRank  = WavePrefixCountBits(1);
		int ActiveListBaseIndex = 0;
		if(WaveIsFirstLane()) {
			InterlockedAdd(g_RWActiveGaussianCountBuffer[0], GaussianCount, ActiveListBaseIndex);
		}
		ActiveListBaseIndex = WaveReadLaneFirst(ActiveListBaseIndex);
		// Store the indices of active gaussians into a list.
		int ActiveListIndex = ActiveListBaseIndex + GaussianRank;

		g_RWActiveGaussianListBuffer[ActiveListIndex] = PackActiveGaussianIndex(InstanceIndex, GaussianIndex);
		g_RWActiveGaussianIndirectSrcBuffer[ActiveListIndex] = ActiveListIndex;
		// The view space align the view direction with the negative z axis
		float LinearDepth = - ViewSpacePosition.z;
		g_RWActiveGaussianLinearDepthSrcBuffer[ActiveListIndex] = LinearDepth;
	}
}

[numthreads(WAVE_SIZE, 1, 1)]
void ProjectActiveGaussians (uint DispatchID : SV_DispatchThreadID) {
	if(DispatchID >= g_RWActiveGaussianCountBuffer[0]) return;
	int ActiveIndex = DispatchID; // Not sorted for now, so we can use the dispatch id directly
	int GaussianIndex, InstanceIndex;
	UnpackActiveGaussianIndex(g_RWActiveGaussianListBuffer[ActiveIndex], InstanceIndex, GaussianIndex);
    
    CameraDescription C = GetCameraDescription();
    Gaussian G = FetchGaussian(GaussianIndex);
    // Project to 2D covariance
#ifndef CARD_SHADERS
	float3x4 InstanceTransform = g_InstanceTransformBuffer[InstanceIndex];
	float3 GaussianWorldPosition = TransformPoint(InstanceTransform, G.Position);
	// Employ EWA jacobian if the camera is perspective.
    float3x3 J = EWAJacobian2(GaussianWorldPosition, C.FieldOfView, C.View);
#else
	float3x4 InstanceTransform = Identity3x4();
	float3 GaussianWorldPosition = G.Position;
	// Orthographic projection jacobian
	// It's the inverse of the scales of the object (in object space)
	float2 InvScales = abs(float2(C.Projection[0][0], C.Projection[1][1])); 
	float3x3 J = float3x3(
        InvScales.x, 0, 0,
        0, InvScales.y, 0,
        0, 0, 0
    );
#endif

#ifndef CARD_SHADERS
    SymmetricMatrix WorldCov3D = ComputeCovarianceMatrix(G.Scale, G.Rotation, ClipMatrix(InstanceTransform));
#else
    SymmetricMatrix WorldCov3D = ComputeCovarianceMatrix(G.Scale, G.Rotation);
#endif

    // float4x4 LocalToView = mul(C.View, ExpandMatrixWithIdentities(InstanceTransform));
	float4 HomogeneousW = mul(C.ProjectionView, float4(GaussianWorldPosition, 1));
    float3 Homogeneous = HomogeneousW.xyz / HomogeneousW.w;

    // Get the covariance matrix in NDC space ([-1, 1] ^ 2)
    float3 Cov2D = ProjectCovarianceMatrixToNDC(
        J, WorldCov3D, C.View
    );

	{
		// 24.12.16: Expand the 2d projection of the gaussian.
		// The data we rendered is trained by a forwarding process with such biasing.
		// So we must expand the gaussian in the same way, otherwise there're
		// empty holes in the output.
		const float H_Var = 0.3f; // The magic number from the original implementation
		// Convert to NDC space for our method
		float VarScaleX = 2.f / C.FilmDimensions.x;
		float VarScaleY = 2.f / C.FilmDimensions.y;
		VarScaleX = VarScaleX * VarScaleX;
		VarScaleY = VarScaleY * VarScaleY;
		float H_VarX = H_Var * VarScaleX;
		float H_VarY = H_Var * VarScaleY;
		Cov2D.x += H_VarX;
		Cov2D.z += H_VarY;
	}

    float  Det           = Cov2D.x * Cov2D.z - Cov2D.y * Cov2D.y;

#ifndef OUTPUT_PBR_G_BUFFER
	SHCoefficents3 SH3 = FetchGaussianSHCoefficients(GaussianIndex, 2);
	float3 ViewDirection = normalize(C.Position - GaussianWorldPosition);
	float3 Color = SH3Evaluate(ViewDirection, SH3, 2);
	g_RWActiveGaussianColorBuffer[ActiveIndex] = Color;
#endif

    // Compute extent in screen space (by finding eigenvalues of
    // 2D covariance matrix). Use extent to compute a bounding rectangle
    // of screen-space tiles that this Gaussian overlaps with. Quit if
    // rectangle covers 0 tiles. 
    // Eigenvalues of 2D covariance matrix denotes the variance of the 
    // Gaussian in the directions of the eigenvectors, which are the
    // principal axes of the Gaussian. 
    float Mean    = 0.5f * (Cov2D.x + Cov2D.z);
	float Discriminant = sqrt(max(0.0f, Mean * Mean - Det));
    float Lambda1 = Mean + Discriminant;
    float Lambda2 = Mean - Discriminant;
    // Find the eigenvectors of the covariance matrix
    float2 Eigenvector1 = float2(Cov2D.y, Lambda1 - Cov2D.x);
    float2 Eigenvector2 = float2(Cov2D.y, Lambda2 - Cov2D.x);
    Eigenvector1 = normalize(Eigenvector1);
    Eigenvector2 = normalize(Eigenvector2);
	// Output the projected quad vectors
	// OPTIMIZE: scale the vectors according to opacity of the gaussian
	float2 ClampedPosition = saturateDown(Homogeneous.xy * 0.25 + 0.5f);
	g_RWActiveGaussianNDCPositionBuffer[ActiveIndex] = PackUnorm16x2(ClampedPosition);
	float LinearDepth = g_RWActiveGaussianLinearDepthSrcBuffer[ActiveIndex];
	// Clamp the radius for gaussians (to fix holes for the dataset)
	// TODO: this is totally an empirical trick. But I found it useful.
	// Otherwise my renderer can be visually inconsistent with the original one intensively in
	// some circumstances...
#ifdef CARD_SHADERS
	float Bias = UB.Card_GaussianClampingScale / InvScales.x;
#else
	float Bias = UB.GaussianClampingScale / LinearDepth;
#endif
	Lambda1 = abs(Lambda1) + Bias*Bias;
	Lambda2 = abs(Lambda2) + Bias*Bias;
 	// Larger objects have larger clamping scale
	float SqrLambda1 = sqrt(Lambda1);
	float SqrLambda2 = sqrt(Lambda2);
    float2 ClampedVector1 = Eigenvector1 * SqrLambda1;
	g_RWActiveGaussianQuadNDCVector0Buffer[ActiveIndex] = PackUnorm16x2(saturateDown(ClampedVector1 * 0.5 + 0.5));
	float2 ClampedVector2 = Eigenvector2 * SqrLambda2;
	g_RWActiveGaussianQuadNDCVector1Buffer[ActiveIndex] = PackUnorm16x2(saturateDown(ClampedVector2 * 0.5 + 0.5));
}

// OPTIMIZE: fine-grain culling (using history HZB)


// The active list indirection buffer is sorted according to their linear depth
// And sent to rasterization.

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void ResolveGBuffers (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	float2 DepthUnnormalized = GetRWDepthTexture(C)[DispatchID].xy;
	float Weight = DepthUnnormalized.y;
	float Depth = DepthUnnormalized.x / max(Weight, 1e-6f);
	float Opacity = GetRWColorTexture(C)[DispatchID].w;
	bool bEmpty = Opacity < UB.OpaqueThreshold;
	if(bEmpty) {
		// Empty pixel.
		Depth = 0;
	}
	// Depth
	GetRWDepthTexture(C)[DispatchID].x = Depth;
	// If the normals are reconstructed from the depth, they are not rendered to the GBuffer
#ifndef RECONSTRUCT_NORMALS_FROM_DEPTH
	// Normalize rasterized gaussian normals
	float3 Normal = g_RWGaussianNormalTexture[DispatchID].xyz;
	if(Opacity >= UB.OpaqueThreshold) Normal /= max(Weight, 1e-6f);
	Normal = Normal * 2 - 1;
	if(any(Normal != -1)) {
		Normal = normalize(Normal);
	}
	g_RWGaussianNormalTexture[DispatchID] = float4(Normal * 0.5 + 0.5, 1);
#endif
}

float TapDepth (CameraDescription C, int2 TapCoords) {
	TapCoords = clamp(TapCoords, 0, C.FilmDimensions - 1);
	return GetDepthTexture(C).Load(int3(TapCoords, 0)).r;
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void FilterDepth (uint2 DispatchID : SV_DispatchThreadID) {
	// fp16 low quality depth -> fp32 filtered depth
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	float SumWeight = 0;
	float SumDepth  = 0;
	bool  bTransparent = false;
	for(int dx = -UB.DepthFilterRadius; dx <= UB.DepthFilterRadius; dx++) {
		for(int dy = -UB.DepthFilterRadius; dy <= UB.DepthFilterRadius; dy++) {
			int2 TapCoords = DispatchID + int2(dx, dy);
			if(IsOutOfFilm(C, TapCoords)) continue;
			float Depth  = TapDepth(C, TapCoords);
			float Opacity = GetColorTexture(C).Load(int3(TapCoords, 0)).w;
			if(Opacity < UB.OpaqueThreshold) {
				// 0104: do not let semi-transparent pixels with large error leak into the depth buffer
				Opacity = 0;
				if(dx == 0 && dy == 0) {
					bTransparent = true;
				}
				continue;
			}
			float Weight = Opacity * (1.f / (1 + abs(dx) + abs(dy)));
			SumWeight += Weight;
			SumDepth  += Depth * Weight;
		}
	}
	
	if(SumWeight <= UB.OpaqueThreshold || bTransparent) SumDepth = 0;
	float FilteredDepth = SumDepth / max(SumWeight, 1e-6f);
	GetRWFilteredDepthTexture(C)[DispatchID] = FilteredDepth;
}

// Combine the GBuffers rendered via gaussians and regular mesh.
[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void CombineGBuffers (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	float4 EmissionA = GetRWEmissionAlphaTexture(C)[DispatchID];
	float RegularOpacity  = EmissionA.w;
	float GaussianOpacity = GetRWColorTexture(C)[DispatchID].w;
	// Filtered depth
	float GaussianFilteredDepth = GetRWFilteredDepthTexture(C)[DispatchID].r;
	float RegularZDepth = GetRasterizationDepthTexture(C).Load(int3(DispatchID, 0)).r;
	float RegularLinearDepth = 0;
	if(RegularZDepth < 1) RegularLinearDepth = ZDepthToLinear(C, RegularZDepth);
	float LerpingFactor = 0;
#if false
	LerpingFactor = RegularOpacity == 0 ? 0 : (1 - GaussianOpacity);
#else
	// The geometry produced should be discrete rather than "smooth"
	// Otherwise SSRT and shading will be greatly affected.
	LerpingFactor = (GaussianOpacity < UB.OpaqueThreshold) ? 0 : 1;
#endif
	float NewFilteredDepth = lerp(RegularLinearDepth, GaussianFilteredDepth, LerpingFactor);
	GetRWFilteredDepthTexture(C)[DispatchID] = NewFilteredDepth;
	// ZDepth, will be 1 + eps when the pixel is transparent
	float ZDepth = NewFilteredDepth == 0 ? ZDEPTH_INF : LinearToZDepth(C, NewFilteredDepth);
	GetRWZDepthTexture(C)[DispatchID] = ZDepth;
	// Gaussians are not emissive.
	float3 GaussianEmission = 0.f;
	GetRWEmissionAlphaTexture(C)[DispatchID].rgb = lerp(EmissionA.rgb, GaussianEmission, LerpingFactor);
	
#ifndef RECONSTRUCT_NORMALS_FROM_DEPTH
	// Normal
	float3 GaussianNormal = normalize(2 * g_RWGaussianNormalTexture[DispatchID].xyz - 1);
	float3 RegularNormal  = normalize(2 * GetNormalTexture(C)[DispatchID].xyz - 1);
	float3 BlendedNormal = lerp(RegularNormal, GaussianNormal, LerpingFactor);
	float  Length = length(BlendedNormal);
	if(Length > 0) {
		BlendedNormal /= Length;
	} else {
		BlendedNormal = LerpingFactor > 0.5 ? GaussianNormal : RegularNormal;
	}
	GetRWNormalTexture(C)[DispatchID] = float4(BlendedNormal * 0.5 + 0.5, 1);
#endif
	// Accumulate opacities. (Color is already blended)
	GetRWColorTexture(C)[DispatchID].w = saturate(RegularOpacity + GaussianOpacity);
}

Texture2D<float> g_InNearHZBTexture;
RWTexture2D<float> g_OutNearHZBTexture;

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void GenerateNearHZB (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	uint2 Dimensions = 0, OutDimensions = 0;
	g_InNearHZBTexture.GetDimensions(Dimensions.x, Dimensions.y);
	g_OutNearHZBTexture.GetDimensions(OutDimensions.x, OutDimensions.y);
	if(any(DispatchID >= OutDimensions)) return;
	int2 BaseCoords = DispatchID * 2;
	float4 ZDepths = 0.f;
	for(int dx = 0; dx < 2; dx++) {
		for(int dy = 0; dy < 2; dy++) {
			int2 TapCoords = BaseCoords + int2(dx, dy);
			if(any(TapCoords >= Dimensions)) continue;
			ZDepths[dx + dy * 2] = g_InNearHZBTexture.Load(int3(TapCoords, 0));
		}
	}
	float  MinZDepth = min(
		min(ZDepths.x, ZDepths.y),
		min(ZDepths.z, ZDepths.w)
	);
	g_OutNearHZBTexture[DispatchID] = MinZDepth;
}

float TapDepthFiltered (CameraDescription C, int2 TapCoords) {
	if(any(TapCoords < 0) || any(TapCoords >= C.FilmDimensions)) return 0;
	return GetFilteredDepthTexture(C).Load(int3(TapCoords, 0)).r;
}

// Reconstruct the normal texture from depth texture, so we dont have to rasterize normals.
// Overdraws from 3DGS are huge burdens on output mergers.
[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void ReconstructNormals (uint2 DispatchID : SV_DispatchThreadID) {
	CameraDescription C = GetCameraDescription();
	if(IsOutOfFilm(C, DispatchID)) return;
	int2   TexCoords = int2(DispatchID);
	float  Depth = TapDepthFiltered(C, TexCoords);
	float3 CameraDirection = NDC2ToCameraDirection(C, FilmToNDC2(C, TexCoords + 0.5f.xx));
	
#ifndef HIGH_QUALITY_NORMAL_RECONSTRUCTION

	float4 Depths = float4(
		TapDepthFiltered(C, TexCoords - int2(1, 0)),
		TapDepthFiltered(C, TexCoords + int2(1, 0)),
		TapDepthFiltered(C, TexCoords - int2(0, 1)),
		TapDepthFiltered(C, TexCoords + int2(0, 1))
	);
	float3 Left  = RecoverWorldSpacePosition(C, TexCoords - int2(1, 0) + 0.5f.xx, Depths.x);
	float3 Right = RecoverWorldSpacePosition(C, TexCoords + int2(1, 0) + 0.5f.xx, Depths.y);
	float3 Up    = RecoverWorldSpacePosition(C, TexCoords - int2(0, 1) + 0.5f.xx, Depths.z);
	float3 Down  = RecoverWorldSpacePosition(C, TexCoords + int2(0, 1) + 0.5f.xx, Depths.w);
	float3 HorizontalDerivative = normalize(Right - Left);
	float3 VerticalDerivative = normalize(Down - Up);
	float3 Normal = normalize(cross(HorizontalDerivative, VerticalDerivative));
	if(dot(Normal, CameraDirection) > 0) {
		Normal = -Normal;
	}
#else

	// Reference: https://atyuwen.github.io/posts/normal-reconstruction/
	// Horizontal 4 points
	float4 H = float4(
		TapDepthFiltered(C, TexCoords - int2(1, 0)),
		TapDepthFiltered(C, TexCoords + int2(1, 0)),
		TapDepthFiltered(C, TexCoords - int2(2, 0)),
		TapDepthFiltered(C, TexCoords + int2(2, 0))
	);
	float2 HError = abs(2 * H.xy - H.zw - Depth);
	float3 HDerivative = 0;
	if(H.x && H.z && HError.x < HError.y) {
		float3 A = RecoverWorldSpacePosition(C, TexCoords - int2(1, 0) + 0.5f.xx, H.x);
		float3 B = RecoverWorldSpacePosition(C, TexCoords - int2(2, 0) + 0.5f.xx, H.z);
		HDerivative = normalize(B - A);
	} else {
		float3 A = RecoverWorldSpacePosition(C, TexCoords + int2(1, 0) + 0.5f.xx, H.y);
		float3 B = RecoverWorldSpacePosition(C, TexCoords + int2(2, 0) + 0.5f.xx, H.w);
		HDerivative = normalize(A - B); 
	}
	// Vertical 4 points
	float4 V = float4(
		TapDepthFiltered(C, TexCoords - int2(0, 1)),
		TapDepthFiltered(C, TexCoords + int2(0, 1)),
		TapDepthFiltered(C, TexCoords - int2(0, 2)),
		TapDepthFiltered(C, TexCoords + int2(0, 2))
	);
	float2 VError = abs(2 * V.xy - V.zw - Depth);
	float3 VDerivative = 0;
	if(V.x && V.z && VError.x < VError.y) {
		float3 A = RecoverWorldSpacePosition(C, TexCoords - int2(0, 1) + 0.5f.xx, V.x);
		float3 B = RecoverWorldSpacePosition(C, TexCoords - int2(0, 2) + 0.5f.xx, V.z);
		VDerivative = normalize(B - A);
	} else {
		float3 A = RecoverWorldSpacePosition(C, TexCoords + int2(0, 1) + 0.5f.xx, V.y);
		float3 B = RecoverWorldSpacePosition(C, TexCoords + int2(0, 2) + 0.5f.xx, V.w);
		VDerivative = normalize(A - B); 
	}
	float3 Normal = normalize(cross(HDerivative, VDerivative));
	if(dot(Normal, CameraDirection) > 0) {
		Normal = -Normal;
	}
#endif
	if(UB.UseReconstructedNormals) {
		GetRWNormalTexture(C)[DispatchID] = float4(Normal * 0.5 + 0.5, 1);
	} else {
		// Just fine tune the normal in case it's broken
		float3 OriginalNormal  = normalize(GetRWNormalTexture(C)[DispatchID].xyz * 2 - 1);
		float OriginalNormalTrust = UB.OriginalNormalWeight * sqrt(saturate(10.f * dot(OriginalNormal, -CameraDirection)));
		float3 CompisiteNormal = normalize(OriginalNormalTrust * OriginalNormal + Normal);
		GetRWNormalTexture(C)[DispatchID] = float4(CompisiteNormal * 0.5 + 0.5, 1);	
	}
}

