#define USING_3DGS_RT
#include "3dgs.hlsl"
#include "probes.hlsl"
#include "radiometry.hlsl"

TriangleHitGroup Trace3DGSHitGroup =
{
    "Trace3DGSAnyHit",
    ""     // AnyHit only, no closest hit
};
RaytracingShaderConfig Trace3DGSShaderConfig =
{
    HIT_BUFFER_SIZE * 2 * 4, // max payload size in bytes
    8   // max attribute size
};

TriangleHitGroup Trace3DGSShadowHitGroup =
{
    "Trace3DGSStochasticAnyHit",
    ""     // AnyHit only, 
};
RaytracingShaderConfig Trace3DGSShadowShaderConfig =
{
    8, // max payload size in bytes
    8  // max attribute size
};

TriangleHitGroup Trace3DGSStochasticHitGroup =
{
    "Trace3DGSStochasticAnyHit",
    "Trace3DGSStochasticClosestHit",
};
RaytracingShaderConfig Trace3DGSStochasticRayShaderConfig =
{
    16, // max payload size in bytes
    8  // max attribute size
};

RaytracingPipelineConfig PipelineConfig =
{
    1 // max trace recursion depth
};

struct Trace3DGSPayload {
    uint  HitGaussianPacked[HIT_BUFFER_SIZE];
    float HitGaussianDepths[HIT_BUFFER_SIZE];
};

struct Trace3DGSStochasticRayPayload {
    float Seed;
    float HitDist;
#if defined(PROBE_UPDATE_STOCHASTIC_RAY_TRACING) || defined(REFLECTION_STOCHASTIC_RAY_TRACING) || defined(STOCHASTIC_RAY_TRACING)
    uint  HitMaterial;
    uint  HitNormal;
#endif
};

// Trace shading rays and shade them according to "3DGS Ray Tracing" in the paper
[shader("raygeneration")]
void Trace3DGSRaygen ()
{
#ifndef NO_RAY_INDIRECTION_LIST
    int RayRank = DispatchRaysIndex().x;
    if(RayRank >= g_RWRayToTraceCountBuffer[0]) return ;
    int RayIndex = g_RWRayToTraceListBuffer[RayRank];
#else
    int RayIndex = DispatchRaysIndex().x;
#endif
    Trace3DGSPayload Payload;
    RayDesc Ray;
    {
        RayToTrace RayData = FetchRayToTrace(RayIndex, UB.RT_MaxTraceDistance);
        // Early out if the ray is invalid
        if(!RayData.IsValid()) return;
        Ray.Origin = RayData.Origin;
        Ray.Direction = RayData.Direction;
        Ray.TMin = RayData.RayTMin;
        Ray.TMax = RayData.RayTMax;
    }
    
    float3 AccumulatedColor = 0;
    float  Transparency = 1.f;
    int IterationCount = 0;
    
#define MAX_ITERATIONS 8
    
    while(Transparency > 0.01f
    && Ray.TMin < Ray.TMax
    && IterationCount < MAX_ITERATIONS) {

        for(int i = 0; i < HIT_BUFFER_SIZE; i++) {
            Payload.HitGaussianPacked[i] = INVALID_U32;
            Payload.HitGaussianDepths[i] = Ray.TMax;
        }

        TraceRay(
            g_HWRT_AccelerationStructure,
            // We dont want back face hits (they are already counted by front face hits)
            RAY_FLAG_CULL_BACK_FACING_TRIANGLES,
            0xff, // All instances
            0, // Hit group index. 0 is the default hit group (shading ray)
            0, // No multiplier for geometry index indexing into the hitgroup
            0, // Shading ray miss shader 0
            Ray,
            Payload
        );
        
        float MaxHitT = Ray.TMax;
        for(int i = 0; i < HIT_BUFFER_SIZE; i++) {
            if(Payload.HitGaussianPacked[i] == INVALID_U32) break;
            uint HitPacked = Payload.HitGaussianPacked[i];
            // AccumulatedColor += float3(1, 0, 0);
            int  GaussianIndex;
            int  InstanceIndex;
            UnpackGaussianHit(HitPacked, InstanceIndex, GaussianIndex);
            Gaussian G   = FetchGaussian(GaussianIndex);
            float RayScaler = 1, RayT = 0;
            // RayDesc LocalRay = GaussianInstance_TransformWorldToLocal(Ray, InstanceIndex, RayScaler);
            float3x4 WorldToObject = g_InstanceInvTransformBuffer[InstanceIndex];
            float3x3 WorldToObjectNormal = g_InstanceInvNormalTransformBuffer[InstanceIndex];
            float3 RayTangent, RayBitangent;
            GetOrthoVectors(Ray.Direction, RayTangent, RayBitangent);
            float3 LocalRayOrigin = TransformPoint(WorldToObject, Ray.Origin);
            float3 LocalRayDirection = TransformVector(WorldToObject, Ray.Direction);
            float3 LocalRayTangent   = TransformVector(WorldToObjectNormal, RayTangent);
            float3 LocalRayBitangent = TransformVector(WorldToObjectNormal, RayBitangent);
            float3x3 RaySpace = float3x3(
                LocalRayTangent / dot(LocalRayTangent, LocalRayTangent),
                LocalRayBitangent / dot(LocalRayBitangent, LocalRayBitangent),
                LocalRayDirection / dot(LocalRayDirection, LocalRayDirection)
            );
#ifdef MAX_RESPONSE_APPROXIMATION
            float Alpha = saturate(
                EvaluateGaussianResponse(LocalRayOrigin, LocalRayDirection, G, RayT)
            );
#else
            float Alpha = 
                EvaluateGaussianResponseRast(LocalRayOrigin, RaySpace, G, RayT);
#endif
            if(Alpha >= UB.HWRT_MinAlphaForGaussianEvaluation) {
                float3 Color = 0;
                if(UB.HWRT_ShadeWithSphericalHarmonics) {
                    SHCoefficents3 SH = FetchGaussianSHCoefficients(GaussianIndex, 1);
                    Color = SH3Evaluate(-normalize(LocalRayDirection), SH, 1);
                } else {
                    GaussianPBR PBR = FetchGaussianPBR(GaussianIndex);
                    Color = PBR.Albedo;
                }
                AccumulatedColor += Color * Alpha * Transparency;
                Transparency *= 1 - Alpha;
            }
            MaxHitT = Payload.HitGaussianDepths[i];
        }

        // Continue the ray from the last hit point
        Ray.TMin = MaxHitT + 1e-4f;

        // Miss occured, no more hits can be found.
        if(Payload.HitGaussianPacked[HIT_BUFFER_SIZE - 1] == INVALID_U32) {
            break;
        }
        IterationCount ++;
    }
    
    // Write the result to the output buffer
    float3 AccumulatedRadiance = UB.HWRT_ShadeWithSphericalHarmonics ? ColorToRadiance(AccumulatedColor) : AccumulatedColor;
    float4 Result = float4(AccumulatedRadiance, Transparency);
    g_RWRayToTraceResultBuffer[RayIndex] = PackRadianceA16(Result);
}

int GetHitGaussianIndex (int HitInstance, int HitPrimitiveIndex, BuiltInTriangleIntersectionAttributes HitAttr) {
    return g_InstanceGaussianIndexOffsetBuffer[HitInstance] + HitPrimitiveIndex / 20;
}

[shader("anyhit")]
void Trace3DGSAnyHit (inout Trace3DGSPayload Payload, in BuiltInTriangleIntersectionAttributes HitAttr)
{
    // Duplicate the payload, and copy back the updated payload
    // This is necessary to get rid of a compiler bug... 
    // See: https://github.com/microsoft/DirectXShaderCompiler/issues/5158
    Trace3DGSPayload InPayload = Payload;
    // DO NOT USE InstanceIndex() (it's just autogenerated but not user defined custom index)
    int HitInstance  = InstanceID();
    if(HitInstance & RT_INSTANCE_REGULAR_MESH_BIT) return; // Not a gaussian instance
    int HitPrimitive = PrimitiveIndex();
    
    int  HitGaussianIndex = GetHitGaussianIndex(HitInstance, HitPrimitive, HitAttr);
    uint HitPacked = PackGaussianHit(HitInstance, HitGaussianIndex);
    float HitDepth = RayTCurrent();
    float OriginalHitDepth = HitDepth;
    for(int i = 0; i < HIT_BUFFER_SIZE; i++) {
        if(HitDepth < InPayload.HitGaussianDepths[i]) {
            Swap(InPayload.HitGaussianPacked[i], HitPacked);
            Swap(InPayload.HitGaussianDepths[i], HitDepth);
        }
    }

    Payload = InPayload;
    
    // Potentially there are more hits. Continue the search.
    if (OriginalHitDepth <= InPayload.HitGaussianDepths[HIT_BUFFER_SIZE - 1]) 
        IgnoreHit();

}

// Trace shadow rays. We only get the stochastic hit distances.
[shader("raygeneration")]
#ifdef DIRECT_ILLUMINATION_SHADOW_RAY_TRACING
void DirectIlluminationTrace3DGSShadowRaygen ()
#elif defined(PROBE_UPDATE_STOCHASTIC_RAY_TRACING)
void Trace3DGSProbeUpdateRaysRaygen ()
#elif defined(REFLECTION_STOCHASTIC_RAY_TRACING)
void Trace3DGSReflectionRaysRaygen ()
#elif defined(STOCHASTIC_RAY_TRACING)
void Trace3DGSStochasticRaysRaygen ()
#else
void Trace3DGSShadowRaygen ()
#endif
{
    CameraDescription C = GetCameraDescription();
#ifndef NO_RAY_INDIRECTION_LIST
    int RayRank = DispatchRaysIndex().x;
    if(RayRank >= g_RWRayToTraceCountBuffer[0]) return ;
    int RayIndex = g_RWRayToTraceListBuffer[RayRank];
#else
    int RayIndex = DispatchRaysIndex().x;
#endif
    Trace3DGSStochasticRayPayload Payload = (Trace3DGSStochasticRayPayload) 0;
    RayDesc Ray;
    {
        // Default true
        bool bFetchOrigin = true;
        float TraceDistance = UB.RT_MaxTraceDistance; 
#ifdef DIRECT_ILLUMINATION_SHADOW_RAY_TRACING
        // The origin lies witin the screen. So no need to fetch it from memory.
        bFetchOrigin = false;
        // Clamp to the distance to the light source for direct illumination shadow rays
        TraceDistance = g_RWDirectIlluminationRayOcclusionThresholdBuffer[RayIndex];
#elif defined(PROBE_UPDATE_STOCHASTIC_RAY_TRACING)
        bFetchOrigin = false;
#elif defined(REFLECTION_STOCHASTIC_RAY_TRACING)
        bFetchOrigin = false;
#elif defined(STOCHASTIC_RAY_TRACING)
        // Fetch origin as all the rays are spawned by SpawnCameraRays
        bFetchOrigin = true;
#endif
        RayToTrace RayData = FetchRayToTrace(RayIndex, TraceDistance, bFetchOrigin);
#if defined(DIRECT_ILLUMINATION_SHADOW_RAY_TRACING) || defined(REFLECTION_STOCHASTIC_RAY_TRACING)
        float2 FilmPosition = UnpackUnorm16x2(g_RWRayToTraceUVPositionBuffer[RayIndex]) * C.FilmDimensions;
        float  LinearDepth  = GetFilteredDepthTexture(C).Load(int3(FilmPosition, 0)).x;
        RayData.Origin = RecoverWorldSpacePosition(C, FilmPosition, LinearDepth);
#elif defined(PROBE_UPDATE_STOCHASTIC_RAY_TRACING)
        // Recover probe update ray origin from probe position
        int2 ProbeIndex = GetProbeUpdateRayProbeIndex(RayIndex);
		float3 ProbeWorldPosition = GetScreenProbePosition(ProbeIndex);
		RayData.Origin = ProbeWorldPosition;
#endif
        // Early out if the ray is invalid
        if(!RayData.IsValid()) return;
        Ray.Origin = RayData.Origin;
        Ray.Direction = RayData.Direction;
        Ray.TMin = RayData.RayTMin;
        Ray.TMax = RayData.RayTMax;
        Payload.HitDist = 0;
        Payload.Seed = RayData.Seed;
    }
    
    // launch only 1 ray
    TraceRay(
        g_HWRT_AccelerationStructure,
        // We dont want back face hits (they are already counted by front face hits)
        RAY_FLAG_CULL_BACK_FACING_TRIANGLES,
        0xff, // All instances
        0, // Hit group index. SBT has been rewritten before dispatching this shader.
        0, // No multiplier for geometry index indexing into the hitgroup
        0, // Shadow ray miss shader 0
        Ray,
        Payload
    );
    
    // Write the result to the output buffer
    bool bHit = Payload.HitDist != 0;
    WriteRayTraceFlags(RayIndex, bHit, bHit ? Payload.HitDist : Ray.TMax);
#if defined(PROBE_UPDATE_STOCHASTIC_RAY_TRACING) || defined(REFLECTION_STOCHASTIC_RAY_TRACING) || defined(STOCHASTIC_RAY_TRACING)
    // Extra hit results
    if(bHit) {
        g_RWRayToTraceResultBuffer[RayIndex] = uint2(Payload.HitMaterial, Payload.HitNormal);
    }
#endif
}


RayDesc GetRayDesc () {
    RayDesc Ray;
    Ray.Origin = WorldRayOrigin();
    Ray.Direction = WorldRayDirection();
    Ray.TMin = RayTMin();
    Ray.TMax = RayTCurrent();
    return Ray;
}


// TODO reduce bandwidth by packing gaussian data
[shader("anyhit")]
void Trace3DGSStochasticAnyHit (inout Trace3DGSStochasticRayPayload Payload, in BuiltInTriangleIntersectionAttributes HitAttr)
{
    // Duplicate the payload, and copy back the updated payload
    // This is necessary to get rid of a compiler bug... 
    // See: https://github.com/microsoft/DirectXShaderCompiler/issues/5158
    Trace3DGSStochasticRayPayload InPayload = Payload;
    int HitInstance  = InstanceID();
    int HitPrimitive = PrimitiveIndex();
    bool ShouldIgnore = false;
    if(HitInstance & RT_INSTANCE_REGULAR_MESH_BIT) {
        // Opaque object, commit hit.
        
        // No need to update the payload if we're not tracing shadow rays
        // stochastic ray hit data is decoded in the closest hit shader
#if !defined(PROBE_UPDATE_STOCHASTIC_RAY_TRACING) && !defined(REFLECTION_STOCHASTIC_RAY_TRACING) && !defined(STOCHASTIC_RAY_TRACING)
        InPayload.HitDist     = RayTCurrent();
#endif
        ShouldIgnore = false;
    } else {
        int  HitGaussianIndex = GetHitGaussianIndex(HitInstance, HitPrimitive, HitAttr);
        Gaussian G = FetchGaussian(HitGaussianIndex);
        RayDesc Ray = GetRayDesc();
        float RayScaler = 1, RayT = 0;
        float3x4 WorldToObject = WorldToObject3x4();
        float3x3 WorldToObjectNormal = g_InstanceInvNormalTransformBuffer[HitInstance];
        float3 LocalRayOrigin = TransformPoint(WorldToObject, Ray.Origin);
        float3 RayTangent, RayBitangent;
        GetOrthoVectors(Ray.Direction, RayTangent, RayBitangent);
        float3 LocalRayDirection = TransformVector(WorldToObject, Ray.Direction);
        float3 LocalRayTangent   = TransformVector(WorldToObjectNormal, RayTangent);
        float3 LocalRayBitangent = TransformVector(WorldToObjectNormal, RayBitangent);
        float3x3 RaySpace = float3x3(
            LocalRayTangent / dot(LocalRayTangent, LocalRayTangent),
            LocalRayBitangent / dot(LocalRayBitangent, LocalRayBitangent),
            LocalRayDirection / dot(LocalRayDirection, LocalRayDirection)
        );
#ifdef MAX_RESPONSE_APPROXIMATION
        float Alpha = saturate(
            EvaluateGaussianResponse(LocalRayOrigin, LocalRayDirection, G, RayT)
        );
#else
        float Alpha = 
            EvaluateGaussianResponseRast(LocalRayOrigin, RaySpace, G, RayT);
#endif
        // Stochastically ignore the hit according to the gaussian response (opacity along the ray)
        ShouldIgnore = Alpha < InPayload.Seed;
        if(ShouldIgnore) {
            InPayload.Seed = (InPayload.Seed - Alpha) / (1 - Alpha);
        } else {
#if defined(PROBE_UPDATE_STOCHASTIC_RAY_TRACING) || defined(REFLECTION_STOCHASTIC_RAY_TRACING)  || defined(STOCHASTIC_RAY_TRACING)
            // Still, we have to roll out a new seed for the next anyhit
            InPayload.Seed = InPayload.Seed / Alpha;
#endif
#if !defined(PROBE_UPDATE_STOCHASTIC_RAY_TRACING) && !defined(REFLECTION_STOCHASTIC_RAY_TRACING) && !defined(STOCHASTIC_RAY_TRACING)
            InPayload.HitDist = RayT / max(1e-6, RayScaler); // Use the max response T as reply
#endif
        }
    }
    Payload = InPayload;
    if(ShouldIgnore) IgnoreHit();
}

[shader("closesthit")]
void Trace3DGSStochasticClosestHit (inout Trace3DGSStochasticRayPayload Payload, in BuiltInTriangleIntersectionAttributes HitAttr)
{
    int HitInstance  = InstanceID();
    int HitPrimitive = PrimitiveIndex();
    RayDesc Ray = GetRayDesc();
    if(HitInstance & RT_INSTANCE_REGULAR_MESH_BIT) {
        // Opaque object, commit hit.
        int MeshInstance = HitInstance - RT_INSTANCE_REGULAR_MESH_BIT;
        SimpleMaterial M = g_MaterialBuffer[MeshInstance];
        int IndexBase  = HitPrimitive * 3 + g_MeshIndexOffsetsBuffer[MeshInstance];
        int VertexBase = g_InstanceGaussianIndexOffsetBuffer[MeshInstance];
        int I0 = g_IndexBuffer[IndexBase + 0] + VertexBase;
        int I1 = g_IndexBuffer[IndexBase + 1] + VertexBase;
        int I2 = g_IndexBuffer[IndexBase + 2] + VertexBase;
        float3x4 ToWorld = ObjectToWorld3x4();
        float3 V0 = TransformPoint(ToWorld, g_VertexBuffer[I0].Position);
        float3 V1 = TransformPoint(ToWorld, g_VertexBuffer[I1].Position);
        float3 V2 = TransformPoint(ToWorld, g_VertexBuffer[I2].Position);
        float3 Normal = normalize(cross(V1 - V0, V2 - V0));
        // Strangely i have to do this for correct reconstruction of normal...
        // TODO find out why
        if(dot(Normal, Ray.Direction) > 0) Normal = -Normal;
        Payload.HitDist     = RayTCurrent();
#if defined(PROBE_UPDATE_STOCHASTIC_RAY_TRACING) || defined(REFLECTION_STOCHASTIC_RAY_TRACING) || defined(STOCHASTIC_RAY_TRACING)
        Payload.HitNormal   = PackNormal(Normal);
#endif
#if defined(PROBE_UPDATE_STOCHASTIC_RAY_TRACING) || defined(STOCHASTIC_RAY_TRACING)
        Payload.HitMaterial = PackCachedMaterial(M.Albedo, M.Roughness);
#endif
#if defined(REFLECTION_STOCHASTIC_RAY_TRACING)
        uint PackedEmission = PackRadianceU32(M.Emissive);
        Payload.HitMaterial = PackedEmission;
#endif
    } else {
        int  HitGaussianIndex = GetHitGaussianIndex(HitInstance, HitPrimitive, HitAttr);
        Gaussian G = FetchGaussian(HitGaussianIndex);
        float RayScaler = 1, RayT = 0;
        float3x4 WorldToObject = WorldToObject3x4();
        float3x3 WorldToObjectNormal = g_InstanceInvNormalTransformBuffer[HitInstance];
        float3 RayTangent, RayBitangent;
        GetOrthoVectors(Ray.Direction, RayTangent, RayBitangent);
        float3 LocalRayOrigin = TransformPoint(WorldToObject, Ray.Origin);
        float3 LocalRayDirection = TransformVector(WorldToObject, Ray.Direction);
        float3 LocalRayTangent   = TransformVector(WorldToObjectNormal, RayTangent);
        float3 LocalRayBitangent = TransformVector(WorldToObjectNormal, RayBitangent);
        float3x3 RaySpace = float3x3(
            LocalRayTangent / dot(LocalRayTangent, LocalRayTangent),
            LocalRayBitangent / dot(LocalRayBitangent, LocalRayBitangent),
            LocalRayDirection / dot(LocalRayDirection, LocalRayDirection)
        );
#ifdef MAX_RESPONSE_APPROXIMATION
        float Alpha = saturate(
            EvaluateGaussianResponse(LocalRayOrigin, LocalRayDirection, G, RayT)
        );
#else
        float Alpha = 
            EvaluateGaussianResponseRast(LocalRayOrigin, RaySpace, G, RayT);
#endif
        GaussianPBR Pbr = FetchGaussianPBR(HitGaussianIndex);
        Payload.HitDist = RayT / max(1e-6, RayScaler); // Use the max response T as reply
#if defined(PROBE_UPDATE_STOCHASTIC_RAY_TRACING) || defined(REFLECTION_STOCHASTIC_RAY_TRACING) || defined(STOCHASTIC_RAY_TRACING)
        float3x3 ObjectToWorldNormal = g_InstanceNormalTransformBuffer[HitInstance];
        float3 Normal = TransformVector(ObjectToWorldNormal, Pbr.Normal);
        // Invert the gaussian normal if it is pointing along the ray direction
        if(dot(Normal, Ray.Direction) > 0) Normal = -Normal;
        Payload.HitNormal   = PackNormal(Normal);
#endif
#if defined(PROBE_UPDATE_STOCHASTIC_RAY_TRACING) || defined(STOCHASTIC_RAY_TRACING)
        Payload.HitMaterial = PackCachedMaterial(Pbr.Albedo, Pbr.Roughness);
#endif
    }
}

