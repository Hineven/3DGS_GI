#define USING_3DGS_RT
#include "3dgs.comp"

TriangleHitGroup Trace3DGSHitGroup =
{
    "Trace3DGSAnyHit",
    ""     // AnyHit only, no closest hit
};

TriangleHitGroup Trace3DGSHitGroupShadow =
{
    "Trace3DGSShadowAnyHit",
    ""     // AnyHit only, 
};

RaytracingShaderConfig ShaderConfig =
{
    HIT_BUFFER_SIZE * 2 * 4, // max payload size
    8   // max attribute size
};

RaytracingPipelineConfig PipelineConfig =
{
    1 // max trace recursion depth
};

struct Trace3DGSPayload {
    uint  HitGaussianPacked[HIT_BUFFER_SIZE];
    float HitGaussianDepths[HIT_BUFFER_SIZE];
};

struct Trace3DGSShadowPayload {
    float Seed;
    float HitDist;
};

// Trace shading rays and shade them according to "3DGS Ray Tracing" in the paper
[shader("raygeneration")]
void Trace3DGSRaygen ()
{
    int RayIndex = DispatchRaysIndex().x;
    if(RayIndex >= g_RWRayToTraceCountBuffer[0]) return ;
    Trace3DGSPayload Payload;
    RayDesc Ray;
    {
        RayToTrace RayData = FetchRayToTrace(RayIndex);
        Ray.Origin = RayData.Origin;
        Ray.Direction = RayData.Direction;
        Ray.TMin = RayData.RayTMin;
        Ray.TMax = RayData.RayTMax;
    }
    
    float3 AccumulatedColor = 0;
    float  Transparency = 1.f;
    int IterationCount = 0;
    
#define MAX_ITERATIONS 8
    
    while(Transparency > 0.01f
    && Ray.TMin < Ray.TMax
    && IterationCount < MAX_ITERATIONS) {

        for(int i = 0; i < HIT_BUFFER_SIZE; i++) {
            Payload.HitGaussianPacked[i] = INVALID_U32;
            Payload.HitGaussianDepths[i] = Ray.TMax;
        }

        TraceRay(
            g_HWRT_AccelerationStructure,
            // We dont want back face hits (they are already counted by front face hits)
            RAY_FLAG_CULL_BACK_FACING_TRIANGLES,
            0xff, // All instances
            0, // Hit group index. 0 is the default hit group (shading ray)
            0, // No multiplier for geometry index indexing into the hitgroup
            0, // Shading ray miss shader 0
            Ray,
            Payload
        );
        
        float MaxHitT = Ray.TMax;
        for(int i = 0; i < HIT_BUFFER_SIZE; i++) {
            if(Payload.HitGaussianPacked[i] == INVALID_U32) break;
            uint HitPacked = Payload.HitGaussianPacked[i];
            // AccumulatedColor += float3(1, 0, 0);
            int  GaussianIndex;
            int  InstanceIndex;
            UnpackGaussianHit(HitPacked, InstanceIndex, GaussianIndex);
            Gaussian G   = FetchGaussian(GaussianIndex);
            float RayScaler = 1, RayT = 0;
            RayDesc LocalRay = GaussianInstance_TransformWorldToLocal(Ray, InstanceIndex, RayScaler);
            float Alpha = saturate(
                EvaluateGaussianResponse(LocalRay.Origin, LocalRay.Direction, G, RayT)
            );
            if(Alpha >= UB.MinAlphaForGaussianEvaluation) {
                SHCoefficents3 SH = FetchGaussianSHCoefficients(GaussianIndex, 1);
                float3 Color = SH3Evaluate(-LocalRay.Direction, SH, 1);
                AccumulatedColor += Color * Alpha * Transparency;
                Transparency *= 1 - Alpha;
            }
            MaxHitT = Payload.HitGaussianDepths[i];
        }

        // Continue the ray from the last hit point
        Ray.TMin = MaxHitT + 1e-4f;

        // Miss occured, no more hits can be found.
        if(Payload.HitGaussianPacked[HIT_BUFFER_SIZE - 1] == INVALID_U32) {
            break;
        }
        IterationCount ++;
    }
    
    // Write the result to the output buffer
    float3 AccumulatedRadiance = ColorToRadiance(AccumulatedColor);
    float4 Result = float4(AccumulatedRadiance, Transparency);
    g_RWRayToTraceResultBuffer[RayIndex] = PackRadianceA16(Result);
}

// Trace shadow rays. We only get the stochastic hit distances.
[shader("raygeneration")]
void Trace3DGSShadowRaygen ()
{
    int RayIndex = DispatchRaysIndex().x;
    if(RayIndex >= g_RWRayToTraceCountBuffer[0]) return ;
    Trace3DGSShadowPayload Payload = (Trace3DGSShadowPayload) 0;
    RayDesc Ray;
    {
        RayToTrace RayData = FetchRayToTrace(RayIndex);
        Ray.Origin = RayData.Origin;
        Ray.Direction = RayData.Direction;
        Ray.TMin = RayData.RayTMin;
        Ray.TMax = RayData.RayTMax;
    }
    
    // launch only 1 ray
    TraceRay(
        g_HWRT_AccelerationStructure,
        // We dont want back face hits (they are already counted by front face hits)
        RAY_FLAG_CULL_BACK_FACING_TRIANGLES,
        0xff, // All instances
        1, // Hit group index. 1 is the hit group for shadow rays
        0, // No multiplier for geometry index indexing into the hitgroup
        1, // Shadow ray miss shader 0
        Ray,
        Payload
    );
    
    // Write the result to the output buffer
    g_RWRayToTraceHitTBuffer[RayIndex] = Payload.HitDist;
}

int GetHitGaussianIndex (int HitInstance, int HitPrimitiveIndex, BuiltInTriangleIntersectionAttributes HitAttr) {
    return g_InstanceGaussianIndexOffsetBuffer[HitInstance] + HitPrimitiveIndex / 20;
}

[shader("anyhit")]
void Trace3DGSAnyHit (inout Trace3DGSPayload Payload, in BuiltInTriangleIntersectionAttributes HitAttr)
{
    // Duplicate the payload, and copy back the updated payload
    // This is necessary to get rid of a compiler bug... 
    // See: https://github.com/microsoft/DirectXShaderCompiler/issues/5158
    Trace3DGSPayload InPayload = Payload;
    int HitInstance  = InstanceIndex();
    int HitPrimitive = PrimitiveIndex();
    
    int  HitGaussianIndex = GetHitGaussianIndex(HitInstance, HitPrimitive, HitAttr);
    uint HitPacked = PackGaussianHit(HitInstance, HitGaussianIndex);
    float HitDepth = RayTCurrent();
    float OriginalHitDepth = HitDepth;
    for(int i = 0; i < HIT_BUFFER_SIZE; i++) {
        if(HitDepth < InPayload.HitGaussianDepths[i]) {
            Swap(InPayload.HitGaussianPacked[i], HitPacked);
            Swap(InPayload.HitGaussianDepths[i], HitDepth);
        }
    }

    Payload = InPayload;
    
    // Potentially there are more hits. Continue the search.
    if (OriginalHitDepth <= InPayload.HitGaussianDepths[HIT_BUFFER_SIZE - 1]) 
        IgnoreHit();

}

RayDesc GetRayDesc () {
    RayDesc Ray;
    Ray.Origin = WorldRayOrigin();
    Ray.Direction = WorldRayDirection();
    Ray.TMin = RayTMin();
    Ray.TMax = RayTCurrent();
    return Ray;
}

[shader("anyhit")]
void Trace3DGSShadowAnyHit (inout Trace3DGSShadowPayload Payload, in BuiltInTriangleIntersectionAttributes HitAttr)
{
    // Duplicate the payload, and copy back the updated payload
    // This is necessary to get rid of a compiler bug... 
    // See: https://github.com/microsoft/DirectXShaderCompiler/issues/5158
    Trace3DGSShadowPayload InPayload = Payload;
    int HitInstance  = InstanceIndex();
    int HitPrimitive = PrimitiveIndex();

    int  HitGaussianIndex = GetHitGaussianIndex(HitInstance, HitPrimitive, HitAttr);
    Gaussian G = FetchGaussian(HitGaussianIndex);
    RayDesc Ray = GetRayDesc();
    float RayScaler = 1, RayT = 0;
    RayDesc LocalRay = GaussianInstance_TransformWorldToLocal(Ray, HitInstance, RayScaler);
    float Alpha = saturate(
        EvaluateGaussianResponse(LocalRay.Origin, LocalRay.Direction, G, RayT)
    );
    // Stochastically ignore the hit according to the gaussian response (opacity along the ray)
    bool ShouldIgnore = Alpha < InPayload.Seed;
    if(ShouldIgnore) {
        Payload.Seed = (Payload.Seed - Alpha) / (1 - Alpha);
    } else Payload.HitDist = RayT / max(1e-6, RayScaler); // Use the max response T as reply
    Payload = InPayload;
    if(ShouldIgnore) IgnoreHit();
}

